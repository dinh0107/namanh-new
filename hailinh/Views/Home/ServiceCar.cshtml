@model hailinh.ViewModel.ServiceCarViewModel
@using hailinh.Models
@using System.Web
@{
    var config = (ConfigSite)HttpContext.Current.Application["ConfigSite"];
    var cs = Model.CarService;
    ViewBag.Title = cs.TitleMeta ?? cs.Title;
    ViewBag.Description = cs.DescriptionMeta ?? cs.Description;
    ViewBag.Canonical = Request.Url?.GetLeftPart(UriPartial.Authority) + Url.Action("ServiceCar", new { url = cs.Slug });

    var share = cs.ImageUrl ?? cs.ImageUrlMobile ?? cs.Image;
    if (!string.IsNullOrEmpty(share))
    {
        ViewBag.ImageShare = Request.Url?.GetLeftPart(UriPartial.Authority) + Url.Content("~/images/carService/" + share);
    }

    Func<string, string> carImg = path =>
    {
        if (string.IsNullOrWhiteSpace(path)) return null;
        if (path.StartsWith("http", StringComparison.OrdinalIgnoreCase)) return path;
        var p = path.StartsWith("/") ? path : ("/images/carService/" + path.TrimStart('/'));
        return Url.Content("~" + p + (p.Contains("?") ? "&w=600" : "?w=600"));
    };
    Func<string, string> detailImg = path =>
    {
        if (string.IsNullOrWhiteSpace(path)) return null;
        if (path.StartsWith("http", StringComparison.OrdinalIgnoreCase)) return path;
        var p = path.StartsWith("/") ? path : ("/images/detail/" + path.TrimStart('/'));
        return Url.Content("~" + p + (p.Contains("?") ? "&w=450" : "?w=450"));
    };

    var heroImg = carImg(cs.ImageUrl ?? cs.Image ?? cs.ImageUrlMobile) ?? Url.Content("~/images/carService/seed/hero-vios.webp");
    var details = cs.Details?.OrderBy(d => d.Sort).ToList() ?? new List<CarServiceDetail>();
    var highlights = details.Where(d => d.CarServiceType == CarServiceType.Highlight).ToList();
    var gallery = details.Where(d => d.CarServiceType == CarServiceType.SupportedCar).ToList();
    var faqs = details.Where(d => d.CarServiceType == CarServiceType.Policy).ToList();
    var prices = cs.CarServicePrices?.OrderBy(p => p.Sort).ToList() ?? new List<CarServicePrice>();
    var testimonials = Model.Banners?.Where(b => b.Active && b.GroupId == 5).OrderBy(b => b.Sort).ToList() ?? new List<Banner>();

    var heroBadgeDefaults = new[] {
        Tuple.Create("Xe đời mới", "Sang trọng, sạch"),
        Tuple.Create("Tài xế chuẩn", "Chuyên nghiệp"),
        Tuple.Create("Giá trọn gói", "Minh bạch 100%")
    };
    var heroBadges = highlights.Take(3).Select(h => Tuple.Create(h.Name, h.Desciption)).ToList();
    while (heroBadges.Count < 3)
    {
        heroBadges.Add(heroBadgeDefaults[heroBadges.Count]);
    }
    var badgeIcons = new[] { "fa-car-side", "fa-user-tie", "fa-tags" };
    var captionTitle = cs.Car;
    if (!string.IsNullOrWhiteSpace(captionTitle))
    {
        var cut = captionTitle.Split(new[] { '(', ',', ';' }, StringSplitOptions.RemoveEmptyEntries)[0].Trim();
        if (cut.Length > 0) { captionTitle = cut; }
    }
    else
    {
        captionTitle = "Toyota Vios";
    }
    var captionSub = "Lựa chọn lý tưởng cho mọi hành trình";
    var includeIcons = new[] { "fa-car", "fa-id-card", "fa-map-location-dot", "fa-headset" };
    var whyIcons = new[] { "fa-gem", "fa-road", "fa-file-invoice-dollar", "fa-clock", "fa-bolt" };

    var included = highlights.Skip(3).Take(4).ToList();
    var whyChoose = highlights.Skip(7).Take(5).ToList();
    if (!included.Any())
    {
        included = highlights.Take(4).ToList();
    }
    if (!included.Any())
    {
        included = new List<CarServiceDetail> {
            new CarServiceDetail { Name = "Xe sạch, đời mới" },
            new CarServiceDetail { Name = "Tài xế chuyên nghiệp, lịch sự" },
            new CarServiceDetail { Name = "Đón trả tận nơi theo yêu cầu" },
            new CarServiceDetail { Name = "Hỗ trợ nhiệt tình 24/7" }
        };
    }
    if (!whyChoose.Any())
    {
        whyChoose = new List<CarServiceDetail> {
            new CarServiceDetail { Name = "Xe chất lượng cao", Desciption = "Đội xe đời mới, bảo dưỡng định kỳ" },
            new CarServiceDetail { Name = "Tài xế kinh nghiệm", Desciption = "Am hiểu tuyến đường, phục vụ chu đáo" },
            new CarServiceDetail { Name = "Giá minh bạch", Desciption = "Báo giá rõ ràng, không phát sinh" },
            new CarServiceDetail { Name = "Hỗ trợ 24/7", Desciption = "Luôn sẵn sàng tư vấn và hỗ trợ" },
            new CarServiceDetail { Name = "Đặt xe nhanh", Desciption = "Nhận báo giá trong vài phút" }
        };
    }
    if (!faqs.Any())
    {
        faqs = new List<CarServiceDetail> {
            new CarServiceDetail { Name = "Giá thuê xe bao gồm những gì?", Body = "<p>Giá đã bao gồm xăng dầu và lương lái xe theo lộ trình thỏa thuận. Phí cầu đường và VAT (nếu có) sẽ được báo trước.</p>" },
            new CarServiceDetail { Name = "Có phát sinh chi phí ẩn không?", Body = "<p>Không. Hà Linh cam kết báo giá minh bạch trước khi xuất phát.</p>" }
        };
    }
    if (!prices.Any())
    {
        prices = new List<CarServicePrice> {
            new CarServicePrice { RouteDescription = "Hà Nội ↔ Ninh Bình", Price = "1.200.000đ" },
            new CarServicePrice { RouteDescription = "Hà Nội ↔ Hạ Long", Price = "1.600.000đ" },
            new CarServicePrice { RouteDescription = "Hà Nội ↔ Hải Phòng", Price = "1.500.000đ" }
        };
    }

    var ctaSource = cs.Slogan ?? "";
    List<string> ctaPills;
    if (ctaSource.Contains("|"))
    {
        ctaPills = ctaSource.Split('|').Select(x => x.Trim()).Where(x => x.Length > 0).Take(3).ToList();
    }
    else
    {
        ctaPills = new List<string> { "Báo giá nhanh", "Xe đời mới", "Hỗ trợ 24/7" };
    }

    var hotline = config?.Hotline ?? "1900 8866";
    var zalo = config?.Zalo;
    var heroSub = !string.IsNullOrWhiteSpace(cs.Slogan) ? cs.Slogan : "Nhỏ gọn – Tiết kiệm – Linh hoạt";
    Func<string, IHtmlString> formatRoute = route =>
    {
        if (string.IsNullOrWhiteSpace(route)) return new HtmlString("");
        var parts = route.Split(new[] { "<=>", "↔", "⇔", " - ", " – " }, StringSplitOptions.None);
        if (parts.Length >= 2)
        {
            return new HtmlString(string.Format("{0} <i class=\"fa-solid fa-arrows-left-right sc-route-arrow\"></i> {1}",
                HttpUtility.HtmlEncode(parts[0].Trim()), HttpUtility.HtmlEncode(parts[1].Trim())));
        }
        return new HtmlString(HttpUtility.HtmlEncode(route));
    };
}

@section styles {
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="@Url.Content("~/Content/service-car-page.css")?v=5" />
}

<main class="service-car-page">
    <section class="sc-hero-banner">
        <div class="container">
            <nav class="sc-breadcrumb" aria-label="Breadcrumb">
                <a href="@Url.Action("Index", "Home")">Trang chủ</a>
                <span class="sep">›</span>
                <a href="@Url.Action("Index", "Home")#tuyen-xe">Dịch vụ</a>
                <span class="sep">›</span>
                <span class="current">@cs.Title</span>
            </nav>

            <div class="sc-hero">
                <div class="sc-hero-copy">
                    <h1>@cs.Title</h1>
                    <p class="sc-hero-sub">@heroSub</p>
                    @if (!string.IsNullOrWhiteSpace(cs.Description))
                    {
                        <div class="sc-hero-desc">@Html.Raw(cs.Description)</div>
                    }
                    else
                    {
                        <div class="sc-hero-desc">
                            <p>Lựa chọn lý tưởng cho các chuyến công tác, đưa đón sân bay, đi tỉnh hoặc các chuyến du lịch ngắn ngày với chất lượng dịch vụ chuyên nghiệp nhất.</p>
                        </div>
                    }
                    <div class="sc-hero-highlights">
                        @for (var bi = 0; bi < 3; bi++)
                        {
                            var badge = heroBadges[bi];
                            var sub = string.IsNullOrWhiteSpace(badge.Item2)
                                ? heroBadgeDefaults[bi].Item2
                                : badge.Item2;
                            <div class="sc-highlight-card">
                                <div class="sc-highlight-ico"><i class="fa-solid @badgeIcons[bi]"></i></div>
                                <strong>@badge.Item1</strong>
                                <span>@sub</span>
                            </div>
                        }
                    </div>
                </div>

                <div class="sc-hero-media">
                    <div class="sc-hero-photo">
                        <img src="@heroImg" alt="@cs.Title" />
                    </div>
                    <div class="sc-hero-caption">
                        <strong>@captionTitle</strong>
                        <em>@captionSub</em>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="sc-booking-strip">
        <div class="container">
            @Html.Action("Form", "Home", new { hideCarType = true, presetTypeCar = cs.Car ?? cs.Capacity ?? cs.Title })
        </div>
    </section>

    @if (prices.Any())
    {
        <section class="sc-section soft">
            <div class="container">
                <h2 class="sc-h2">Bảng giá tham khảo @(string.IsNullOrWhiteSpace(cs.Car) ? cs.Title : ("thuê xe " + cs.Car))</h2>
                <p class="sc-sub">Giá có thể thay đổi theo thời điểm, vui lòng liên hệ để nhận báo giá chính xác nhất.</p>
                <div class="sc-price-card" id="scPriceCard">
                    <table class="sc-price-table">
                        <thead>
                            <tr>
                                <th>Hành trình đi (2 chiều)</th>
                                <th>Giá tham khảo</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ var pi = 0; }
                            @foreach (var item in prices)
                            {
                                <tr class="@(pi >= 5 ? "sc-price-more" : null)">
                                    <td>@formatRoute(item.RouteDescription)</td>
                                    <td>@item.Price</td>
                                </tr>
                                pi++;
                            }
                        </tbody>
                    </table>
                    @if (prices.Count > 5)
                    {
                        <button type="button" class="sc-price-more-btn" id="scPriceMoreBtn">
                            Xem thêm các hành trình khác <i class="fa-solid fa-chevron-down"></i>
                        </button>
                    }
                </div>
                <div class="sc-price-cta">
                    <a href="#booking-form-card" class="sc-btn-outline-orange">Nhận báo giá chi tiết <i class="fa-solid fa-arrow-right"></i></a>
                </div>
                <div class="sc-note">
                    <strong>Ghi chú:</strong>
                    <ul>
                        <li>Giá đã bao gồm xăng dầu, lương lái xe (trừ khi có thỏa thuận khác).</li>
                        <li>Chưa gồm phí cầu đường và thuế VAT (nếu xuất hóa đơn).</li>
                        <li>Giá có thể thay đổi theo mùa và lộ trình cụ thể.</li>
                    </ul>
                </div>
            </div>
        </section>
    }

    @if (included.Any())
    {
        <section class="sc-section alt">
            <div class="container">
                <h2 class="sc-h2">Dịch vụ bao gồm</h2>
                <div class="sc-include-grid" style="margin-top:24px">
                    @{ var ii = 0; }
                    @foreach (var item in included)
                    {
                        <div class="sc-include-item">
                            <div class="sc-include-ico"><i class="fa-solid @(includeIcons[ii % includeIcons.Length])"></i></div>
                            <h3>@item.Name</h3>
                        </div>
                        ii++;
                    }
                </div>
            </div>
        </section>
    }

    @if (gallery.Any())
    {
        var galImgs = new List<(string url, string name)>();
        foreach (var item in gallery)
        {
            if (!string.IsNullOrWhiteSpace(item.Image))
            {
                galImgs.Add((detailImg(item.Image), item.Name));
            }
            if (!string.IsNullOrWhiteSpace(item.ListImage))
            {
                foreach (var p in item.ListImage.Split(',').Select(x => x.Trim()).Where(x => x.Length > 0))
                {
                    galImgs.Add((detailImg(p), item.Name));
                }
            }
        }
        galImgs = galImgs.GroupBy(x => x.url).Select(g => g.First()).Take(3).ToList();
        if (!galImgs.Any())
        {
            galImgs = new List<(string url, string name)> {
                (Url.Content("~/images/detail/seed/exterior.webp"), "Ngoại thất"),
                (Url.Content("~/images/detail/seed/interior.webp"), "Nội thất"),
                (Url.Content("~/images/detail/seed/trunk.webp"), "Cốp xe")
            };
        }
        if (galImgs.Any())
        {
            <section class="sc-section soft">
                <div class="container">
                    <h2 class="sc-h2">Hình ảnh thực tế</h2>
                    <p class="sc-sub">Xe thật đang vận hành tại Hà Linh</p>
                    <div class="sc-gallery">
                        <a class="sc-gallery-main" href="@galImgs[0].url" data-fancybox="sc-gallery" data-caption="@galImgs[0].name">
                            <img src="@galImgs[0].url" alt="@galImgs[0].name" />
                        </a>
                        @if (galImgs.Count > 1)
                        {
                            <div class="sc-gallery-side">
                                @for (var g = 1; g < galImgs.Count; g++)
                                {
                                    <a href="@galImgs[g].url" data-fancybox="sc-gallery" data-caption="@galImgs[g].name">
                                        <img src="@galImgs[g].url" alt="@galImgs[g].name" />
                                    </a>
                                }
                            </div>
                        }
                    </div>
                </div>
            </section>
        }
    }

    @if (whyChoose.Any())
    {
        <section class="sc-section alt">
            <div class="container">
                <h2 class="sc-h2">Tại sao nên chọn Hà Linh?</h2>
                <div class="sc-why-grid" style="margin-top:28px">
                    @{ var wi = 0; }
                    @foreach (var item in whyChoose)
                    {
                        <div class="sc-why-item">
                            <div class="sc-why-ico"><i class="fa-solid @(whyIcons[wi % whyIcons.Length])"></i></div>
                            <h3>@item.Name</h3>
                            @if (!string.IsNullOrWhiteSpace(item.Desciption))
                            {
                                <p>@item.Desciption</p>
                            }
                        </div>
                        wi++;
                    }
                </div>
            </div>
        </section>
    }

    @if (faqs.Any())
    {
        <section class="sc-section soft sc-faq">
            <div class="container">
                <h2 class="sc-h2">Câu hỏi thường gặp</h2>
                <div class="accordion" id="scFaqAccordion" style="margin-top:20px">
                    @{ var faqIdx = 0; }
                    @foreach (var item in faqs)
                    {
                        var collapseId = "scFaqC" + faqIdx;
                        var open = faqIdx == 0;
                        <div class="accordion-item">
                            <h2 class="accordion-header">
                                <button class="accordion-button @(open ? "" : "collapsed")" type="button" data-bs-toggle="collapse" data-bs-target="#@collapseId" aria-expanded="@open.ToString().ToLower()">
                                    @item.Name
                                </button>
                            </h2>
                            <div id="@collapseId" class="accordion-collapse collapse @(open ? "show" : "")" data-bs-parent="#scFaqAccordion">
                                <div class="accordion-body">@Html.Raw(item.Body ?? item.Desciption)</div>
                            </div>
                        </div>
                        faqIdx++;
                    }
                </div>
            </div>
        </section>
    }

    @if (testimonials.Any())
    {
        var review = testimonials.First();
        <section class="sc-section alt">
            <div class="container">
                <h2 class="sc-h2">Khách hàng nói gì?</h2>
                <div class="sc-review" style="margin-top:20px">
                    @{
                        var av = !string.IsNullOrWhiteSpace(review.Image)
                            ? Url.Content("~/images/banners/" + review.Image)
                            : Url.Content("~/images/banners/seed/avatar.webp");
                    }
                    <img src="@av" alt="@review.BannerName" />
                    <div class="sc-stars">
                        <i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(review.Content))
                    {
                        <p>@Html.Raw(review.Content)</p>
                    }
                    else if (!string.IsNullOrWhiteSpace(review.Slogan))
                    {
                        <p>@review.Slogan</p>
                    }
                    <strong>@review.BannerName</strong>
                </div>
            </div>
        </section>
    }

    <section class="sc-cta">
        <div class="container">
            <h2>Bạn đã có lịch trình? Nhận báo giá xe trong vài phút</h2>
            <div class="sc-cta-pills">
                @foreach (var pill in ctaPills)
                {
                    <span>@pill</span>
                }
            </div>
            <div class="sc-cta-actions">
                <a class="sc-btn-ghost" href="tel:@hotline"><i class="fa-solid fa-phone"></i> Gọi ngay</a>
                @if (!string.IsNullOrWhiteSpace(zalo))
                {
                    <a class="sc-btn-ghost" href="https://zalo.me/@zalo" target="_blank" rel="noopener"><i class="fa-solid fa-comment"></i> Zalo</a>
                }
                <a class="sc-btn-orange" href="#booking-form-card">Nhận báo giá</a>
            </div>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(cs.Body))
    {
        <section class="sc-section">
            <div class="container">
                <div class="sc-body-content car-body detail-content">@Html.Raw(cs.Body)</div>
                <div class="view-all text-center mt-3 text-primary" style="cursor:pointer">Xem thêm</div>
            </div>
        </section>
    }
</main>

@section scripts {
    <script>
        (function () {
            var moreBtn = document.getElementById('scPriceMoreBtn');
            var card = document.getElementById('scPriceCard');
            if (moreBtn && card) {
                moreBtn.addEventListener('click', function () {
                    card.classList.toggle('is-open');
                    moreBtn.innerHTML = card.classList.contains('is-open')
                        ? 'Thu gọn <i class="fa-solid fa-chevron-up"></i>'
                        : 'Xem thêm các hành trình khác <i class="fa-solid fa-chevron-down"></i>';
                });
            }
        })();
    </script>
}
