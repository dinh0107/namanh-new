@model hailinh.ViewModel.HeaderViewModel
@using hailinh.Models
@using System.Configuration
@{
    var config = (ConfigSite)HttpContext.Current.Application["ConfigSite"];
    var logoUrl = config?.Image != null ? (Url.Content("~/images/configs/" + config.Image) + "?h=84") : null;
    var siteTitle = config?.Title ?? "Hà Linh - Cho thuê xe có lái";
    var hotline = config?.Hotline ?? "1900 8866";
    var articleParents = Model?.ArticleCategories?
        .Where(a => a.TypePost == TypePost.Article && a.ParentId == null)
        .ToList() ?? new List<ArticleCategory>();
    var services = Model?.Services?.ToList() ?? new List<CarService>();
    var serviceUrl = services.Any()
        ? Url.Action("ServiceCar", "Home", new { url = services.First().Slug })
        : "#tuyen-xe";
    var newsUrl = articleParents.Any()
        ? GetCategoryUrl(articleParents.First())
        : "#tin-tuc";
}

@functions {
    string GetCategoryUrl(ArticleCategory category)
    {
        if (category == null) return "#";
        if (category.Redirect)
        {
            return category.Url;
        }
        return Url.Action("ArticleCategory", "Home", new { url = category.Url });
    }
}

<header class="main-header shadow-sm">
    <nav class="navbar navbar-expand-lg navbar-light py-2">
        <div class="container">
            <a class="navbar-brand py-1" href="/">
                @if (logoUrl != null)
                {
                    <img src="@logoUrl" alt="@siteTitle" height="42" class="d-inline-block align-text-top object-fit-contain" />
                }
              
            </a>

            <div class="d-flex align-items-center d-lg-none gap-2">
                <a class="btn btn-brand-orange btn-sm px-3 py-1 fw-bold" href="#booking-form">
                    <i class="fa-regular fa-file-lines me-1"></i> Báo giá
                </a>
                <button class="navbar-toggler border-0 shadow-none p-2" type="button" data-bs-toggle="collapse" data-bs-target="#headerNavbarNav" aria-controls="headerNavbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
            </div>

            <div class="collapse navbar-collapse" id="headerNavbarNav">
                <ul class="navbar-nav mx-auto mb-2 mb-lg-0 align-items-lg-center">
                    <li class="nav-item">
                        <a class="nav-link active" aria-current="page" href="/">Trang chủ</a>
                    </li>

                    @if (services.Any())
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="/#tuyen-xe" id="servicesDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Thuê xe
                            </a>
                            <ul class="dropdown-menu shadow border-0" aria-labelledby="servicesDropdown">
                                @foreach (var s in services)
                                {
                                    <li>
                                        <a class="dropdown-item py-2" href="@Url.Action("ServiceCar", "Home", new { url = s.Slug })">
                                            <i class="fa-solid fa-chevron-right text-primary me-2" style="font-size: 0.75rem;"></i>@s.Title
                                        </a>
                                    </li>
                                }
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" href="#tuyen-xe">Các dòng xe</a>
                        </li>
                    }

                    <li class="nav-item">
                        <a class="nav-link" href="#bang-gia">Bảng giá</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#tuyen-xe">Tuyến xe</a>
                    </li>
                    @*<li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Introduct", "Home")">Giới thiệu</a>
                    </li>

                    @if (articleParents.Any())
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="@newsUrl" id="newsDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Tin tức
                            </a>
                            <ul class="dropdown-menu shadow border-0" aria-labelledby="newsDropdown">
                                @foreach (var cat in articleParents)
                                {
                                    <li>
                                        <a class="dropdown-item py-2" href="@GetCategoryUrl(cat)">
                                            <i class="fa-regular fa-newspaper text-primary me-2" style="font-size: 0.75rem;"></i>@cat.CategoryName
                                        </a>
                                    </li>
                                }
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" href="#tin-tuc">Tin tức</a>
                        </li>
                    }*@

                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Contact", "Home")">Liên hệ</a>
                    </li>
                </ul>

                <div class="d-none d-lg-flex align-items-center gap-2">
                    <a class="btn btn-brand-orange px-4 py-2" href="#booking-form">
                        <i class="fa-regular fa-file-lines me-1.5"></i>
                        <span>Nhận báo giá</span>
                    </a>
                </div>
            </div>
        </div>
    </nav>
</header>
<script>
    (function () {
        var isDesktop = function () { return window.innerWidth >= 992; };
        var dropdownToggles = document.querySelectorAll('.main-header .dropdown-toggle');

        dropdownToggles.forEach(function (toggle) {
            toggle.addEventListener('click', function (e) {
                if (isDesktop()) {
                    e.preventDefault();
                    e.stopPropagation();
                    var href = toggle.getAttribute('href');
                    if (href && href !== '#' && !href.startsWith('javascript')) {
                        if (href.startsWith('/#')) {
                            var hash = href.substring(1);
                            if (window.location.pathname === '/' || window.location.pathname === '') {
                                var target = document.querySelector(hash);
                                if (target) {
                                    target.scrollIntoView({ behavior: 'smooth' });
                                    return;
                                }
                            }
                        }
                        window.location.href = href;
                    }
                }
            });
        });
    })();
</script>
