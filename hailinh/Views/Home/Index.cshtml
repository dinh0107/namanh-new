    {
        ViewBag.ImageShare = Request.Url?.GetLeftPart(UriPartial.Authority) + Path.Combine("/images/configs/", share);
    }
    var hotline = config?.Hotline ?? "1900 8866";
    var zaloUrl = !string.IsNullOrWhiteSpace(config?.Zalo) ? "https://zalo.me/" + config.Zalo.Trim() : ("tel:" + hotline);
