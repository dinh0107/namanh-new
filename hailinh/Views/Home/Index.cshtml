                                                <span><strong>Mục đích:</strong> @(!string.IsNullOrWhiteSpace(car.Type) ? car.Type : "Đoàn thể, sự kiện, du lịch")</span>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="fleet-card-actions">
                                        <button type="button" onclick="window.selectCarAndBook('@capacity')" class="btn-fleet-book">
                                            <span>Đặt xe</span>
                                        </button>
                                        <a href="@carUrl" class="btn-fleet-detail">
                                            <span>Chi tiết</span>
                                            <i class="fa-solid fa-arrow-right small"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</section>
@{
    Func<string, string> NormTab = name => (name ?? "").ToLowerInvariant().Replace(" ", "").Replace("ỗ", "o").Replace("ổ", "o").Replace("ô", "o");
    var tabsOrdered = priceLangdings.OrderBy(t => t.Sort).ToList();
    Func<string, PriceLangding> FindTab = token =>
        priceLangdings.FirstOrDefault(t => { var n = NormTab(t.Name); return n == token || n.StartsWith(token); });
    var tab4 = FindTab("4cho") ?? tabsOrdered.ElementAtOrDefault(0);
    var tab7 = FindTab("7cho") ?? tabsOrdered.ElementAtOrDefault(1);
    var tab16 = FindTab("16cho") ?? tabsOrdered.ElementAtOrDefault(2);
    var tab29 = FindTab("29cho") ?? tabsOrdered.ElementAtOrDefault(3);
    var tab45 = FindTab("45cho") ?? tabsOrdered.ElementAtOrDefault(4);
    var tabLim = priceLangdings.FirstOrDefault(t => NormTab(t.Name).Contains("limo")) ?? tabsOrdered.ElementAtOrDefault(5);
    Func<PriceLangding, string> TabImg = tab =>
        tab != null && !string.IsNullOrWhiteSpace(tab.Image)
            ? Url.Content("~/images/pricelangdings/" + tab.Image)
            : null;
    Func<string, PriceLangding, string> PriceFor = (dest, tab) =>
    {
        var loc = tab?.Locations?.FirstOrDefault(l => l.Active && string.Equals(l.Name, dest, StringComparison.OrdinalIgnoreCase));
        var p = loc?.GetDisplayPrice();
        return string.IsNullOrWhiteSpace(p) ? "Liên hệ" : p.Trim();
    };
    var displayRoutes = priceLangdings
        .SelectMany(p => p.Locations ?? new List<Location>())
        .Where(l => l.Active)
        .GroupBy(l => l.Name, StringComparer.OrdinalIgnoreCase)
        .OrderBy(g => g.Min(x => x.Sort))
        .Select(g => new
        {
            Name = g.First().Name,
            Hot = g.Any(x => x.Hot),
            P4 = PriceFor(g.Key, tab4),
            P7 = PriceFor(g.Key, tab7),
            P16 = PriceFor(g.Key, tab16),
            P29 = PriceFor(g.Key, tab29),
            P45 = PriceFor(g.Key, tab45),
            PLim = PriceFor(g.Key, tabLim)
        })
        .ToList();
}
<section id="bang-gia">
    <div class="scenic-bg" aria-hidden="true"></div>
    <div class="pricing-container">

        <div class="top-trust-wrapper">
            <div class="top-trust-pill">
                <div class="trust-item">
                    <div class="badge-icon badge-check" aria-hidden="true">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
                            <path d="M5 12.5L10 17.5L19 7.5" stroke="#fff" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </div>
                    <span>Giá minh bạch</span>
                </div>
                <div class="trust-divider" aria-hidden="true"></div>
                <div class="trust-item">
                    <div class="badge-icon badge-chat" aria-hidden="true">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none">
                            <path d="M4 6.5A2.5 2.5 0 0 1 6.5 4h11A2.5 2.5 0 0 1 20 6.5v7A2.5 2.5 0 0 1 17.5 16H10l-4 3.5V6.5Z" fill="#fff"/>
                        </svg>
                    </div>
                    <span>Tư vấn nhanh</span>
                </div>
                <div class="trust-divider" aria-hidden="true"></div>
                <div class="trust-item">
                    <div class="badge-icon badge-24h" aria-hidden="true">24h</div>
                    <span>Hỗ trợ 24/7</span>
                </div>
            </div>
        </div>

        <div class="pricing-header">
            <h2 class="pricing-title @editClass"@Html.Raw(EditAttrs("HomePriceTitle", "config", null))>@priceTitle</h2>
            <p class="pricing-subtitle @editClass"@Html.Raw(EditAttrs("HomePriceDesc", "config", null))>@priceDesc</p>
        </div>

        <div class="table-card">
            <div class="table-responsive">
                <table class="pricing-table">
                    <thead>
                        <tr>
                            <th class="col-route">
                                <div class="th-route-wrapper">
                                    <div class="route-header-icon">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/>
                                            <circle cx="12" cy="9" r="2.8"/>
                                        </svg>
                                    </div>
                                    <div class="route-header-title">
                                        <span>HÀNH TRÌNH</span>
                                        <span>2 CHIỀU</span>
                                    </div>
                                </div>
                            </th>
                            @{
                                var carCols = new[]
                                {
                                    new { Tab = tab4, Label = "4 CHỖ" },
                                    new { Tab = tab7, Label = "7 CHỖ" },
                                    new { Tab = tab16, Label = "16 CHỖ" },
                                    new { Tab = tab29, Label = "29 CHỖ" },
                                    new { Tab = tab45, Label = "45 CHỖ" },
                                    new { Tab = tabLim, Label = "LIMOUSINE" }
                                };
                            }
                            @foreach (var col in carCols)
                            {
                                var img = TabImg(col.Tab);
                                <th class="col-car">
                                    <div class="car-header-cell">
                                        @if (img != null)
                                        {
                                            <img src="@img" alt="@col.Label" class="car-header-img" />
                                        }
                                        <span class="car-header-label">@(col.Tab?.Name?.ToUpperInvariant() ?? col.Label)</span>
                                    </div>
                                </th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @if (displayRoutes.Any())
                        {
                            foreach (var loc in displayRoutes)
                            {
                                <tr class="@(loc.Hot ? "row-hot" : null)" onclick="window.selectRouteAndBook('Hà Nội', '@loc.Name', '7 chỗ')">
                                    <td class="route-cell">
                                        <div class="route-content @(loc.Hot ? "hot-badge-wrapper" : null)">
                                            @if (loc.Hot)
                                            {
                                                <span class="hot-badge" aria-label="HOT">
                                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="#ff6a00" d="M12 2s4 5.2 4 9a4 4 0 0 1-8 0c0-2.2 1.4-4.6 2.4-6.2C9.2 7.6 8 10 8 12.2A6 6 0 0 0 12 22a6 6 0 0 0 6-6.4C18 10.2 12 2 12 2z"/><path fill="#ffcc33" d="M12 10.2c1.2 1.6 1.8 2.8 1.8 4a1.8 1.8 0 1 1-3.6 0c0-1 .6-2.2 1.8-4z"/></svg>
                                                    <span>HOT</span>
                                                </span>
                                            }
                                            else
                                            {
                                                <svg class="pin-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                                    <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 0 1 0-5 2.5 2.5 0 0 1 0 5z"/>
                                                </svg>
                                            }
                                            <span>Hà Nội ↔ @loc.Name</span>
                                        </div>
                                    </td>
                                    <td><span class="@(loc.P4 == "Liên hệ" ? "contact-value" : "price-value")">@loc.P4</span></td>
                                    <td><span class="@(loc.P7 == "Liên hệ" ? "contact-value" : "price-value")">@loc.P7</span></td>
                                    <td><span class="@(loc.P16 == "Liên hệ" ? "contact-value" : "price-value")">@loc.P16</span></td>
                                    <td><span class="@(loc.P29 == "Liên hệ" ? "contact-value" : "price-value")">@loc.P29</span></td>
                                    <td><span class="@(loc.P45 == "Liên hệ" ? "contact-value" : "price-value")">@loc.P45</span></td>
                                    <td><span class="@(loc.PLim == "Liên hệ" ? "contact-value" : "price-value")">@loc.PLim</span></td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="bottom-grid">
            <section class="notes-card">
