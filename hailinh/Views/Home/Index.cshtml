                                        <span class="fleet-tag-pill" title="@car.Slogan">
                                            <i class="fa-solid fa-sparkles"></i>
                                            <span>@shortTag</span>
                                        </span>
                                    </div>
                                </div>

                                <div class="fleet-card-body">
                                    <div>
                                        <h3 class="fleet-car-title">@car.Title</h3>
