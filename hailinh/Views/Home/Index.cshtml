                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</section>
@{
    Func<string, string> NormTab = name => (name ?? "").ToLowerInvariant().Replace(" ", "").Replace("ỗ", "o").Replace("ổ", "o").Replace("ô", "o");
    var tabsOrdered = priceLangdings.OrderBy(t => t.Sort).ToList();
    Func<string, PriceLangding> FindTab = token =>
        priceLangdings.FirstOrDefault(t => { var n = NormTab(t.Name); return n == token || n.StartsWith(token); });
    var tab4 = FindTab("4cho") ?? tabsOrdered.ElementAtOrDefault(0);
    var tab7 = FindTab("7cho") ?? tabsOrdered.ElementAtOrDefault(1);
    var tab16 = FindTab("16cho") ?? tabsOrdered.ElementAtOrDefault(2);
    var tab29 = FindTab("29cho") ?? tabsOrdered.ElementAtOrDefault(3);
    var tab45 = FindTab("45cho") ?? tabsOrdered.ElementAtOrDefault(4);
    var tabLim = priceLangdings.FirstOrDefault(t => NormTab(t.Name).Contains("limo")) ?? tabsOrdered.ElementAtOrDefault(5);
    Func<PriceLangding, string> TabImg = tab =>
        tab != null && !string.IsNullOrWhiteSpace(tab.Image)
            ? (tab.Image.StartsWith("http") ? tab.Image : Url.Content("~/images/pricelangdings/" + tab.Image + "?w=200"))
            : null;
    Func<string, PriceLangding, string> PriceFor = (dest, tab) =>
    {
        var loc = tab?.Locations?.FirstOrDefault(l => l.Active && string.Equals(l.Name, dest, StringComparison.OrdinalIgnoreCase));
        var p = loc?.GetDisplayPrice();
        return string.IsNullOrWhiteSpace(p) ? "Liên hệ" : p.Trim();
    };
    var displayRoutes = priceLangdings
        .SelectMany(p => p.Locations ?? new List<Location>())
        .Where(l => l.Active)
        .GroupBy(l => l.Name, StringComparer.OrdinalIgnoreCase)
        .OrderBy(g => g.Min(x => x.Sort))
        .Select(g => new
        {
            Name = g.First().Name,
            Hot = g.Any(x => x.Hot),
            P4 = PriceFor(g.Key, tab4),
            P7 = PriceFor(g.Key, tab7),
            P16 = PriceFor(g.Key, tab16),
            P29 = PriceFor(g.Key, tab29),
            P45 = PriceFor(g.Key, tab45),
            PLim = PriceFor(g.Key, tabLim)
        })
        .ToList();
}
