<section class="hero-section">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <div class="hero-badge">
                    <i class="fa-solid fa-shield-halved text-primary"></i>
                    <span class="@(isAdmin && heroBanner != null ? "js-inline-edit" : null)"@Html.Raw(EditAttrs("Content", "banner", heroBanner?.Id))>@heroBadge</span>
                </div>

                <h1 class="hero-title @(isAdmin && heroBanner != null ? "js-inline-edit" : null)"@Html.Raw(EditAttrs("BannerName", "banner", heroBanner?.Id))>
                    @Html.Raw(heroTitle)
                </h1>

                <p class="hero-desc @(isAdmin && heroBanner != null ? "js-inline-edit" : null)"@Html.Raw(EditAttrs("Slogan", "banner", heroBanner?.Id))>
                    @heroDesc
                </p>

                <div class="d-flex flex-wrap align-items-center gap-3 mb-4">
                    <button type="button" onclick="window.selectCarAndBook()" class="btn btn-brand-orange px-4 py-3 fw-bold fs-6">
                        <i class="fa-regular fa-file-lines me-2"></i>
                        <span>Nhận báo giá ngay</span>
                    </button>
                    <a class="btn btn-brand-outline px-4 py-3 fw-bold fs-6 d-inline-flex align-items-center gap-2" href="@zaloUrl" target="_blank" rel="noopener">
                        <i class="fa-solid fa-phone-volume text-primary"></i>
                        <span>Gọi / Zalo ngay</span>
                    </a>
                </div>

                <div class="hero-features">
                    <div class="item">
                        <i class="fa-solid fa-car text-primary"></i>
                        <span>Xe đời mới 100%</span>
                    </div>
                    <div class="item">
                        <i class="fa-solid fa-user-tie text-primary"></i>
                        <span>Tài xế chuẩn mực</span>
                    </div>
                    <div class="item">
                        <i class="fa-solid fa-shield-check text-primary"></i>
                        <span>Giá trọn gói minh bạch</span>
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="hero-img-wrap">
                    <img src="@heroImg" alt="@siteTitle" fetchpriority="high" decoding="async" />
                    <div class="hero-img-overlay-badge">
                        @siteTitle
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<section class="container booking-section-wrap" id="booking-form">
    @Html.Action("Form", "Home")
</section>
<section class="fleet-section-wrap" id="tuyen-xe">
