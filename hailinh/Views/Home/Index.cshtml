        <div class="text-center mb-4">
            <h2 class="section-title mb-2 @editClass"@Html.Raw(EditAttrs("HomeFleetTitle", "config", null))>@fleetTitle</h2>
            <div class="title-line text-primary mb-2">
                <i class="fa-solid fa-car-side fs-5"></i>
            </div>
            <p class="section-subtitle @editClass"@Html.Raw(EditAttrs("HomeFleetDesc", "config", null))>@fleetDesc</p>
        </div>

        <div class="fleet-slider-container">
