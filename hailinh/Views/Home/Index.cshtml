                @{
                    var fIndex = 1;
                }
                @foreach (var faq in faqs)
                {
                    var isFirst = fIndex == 1;
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="faqHeading@(fIndex)">
                            <button class="accordion-button @(isFirst ? "" : "collapsed")" type="button" data-bs-toggle="collapse" data-bs-target="#faqCollapse@(fIndex)" aria-expanded="@(isFirst ? "true" : "false")" aria-controls="faqCollapse@(fIndex)">
                                <i class="fa-regular fa-file-lines text-primary me-2"></i>
                                <span>@faq.BannerName</span>
                            </button>
                        </h2>
                        <div id="faqCollapse@(fIndex)" class="accordion-collapse collapse @(isFirst ? "show" : "")" aria-labelledby="faqHeading@(fIndex)" data-bs-parent="#homeFaqAccordion">
                            <div class="accordion-body">
                                @Html.Raw(faq.Content ?? faq.Slogan)
                            </div>
                        </div>
                    </div>
                    fIndex++;
                }
            </div>

            <div class="mt-4 p-4 rounded-3 text-center bg-white border shadow-sm">
                <h4 class="h6 fw-bold text-dark mb-1 @editClass"@Html.Raw(EditAttrs("HomeFaqCtaTitle", "config", null))>@faqCtaTitle</h4>
                <p class="small text-muted mb-3 @editClass"@Html.Raw(EditAttrs("HomeFaqCtaDesc", "config", null))>@faqCtaDesc</p>
                <div class="d-flex justify-content-center gap-3">
                    <a href="tel:@hotline" class="btn btn-primary btn-sm px-3 fw-bold" style="background-color: var(--brand-dark-blue); border: none;">
                        <i class="fa-solid fa-phone me-1"></i> Hotline: @hotline
                    </a>
                    <a href="@zaloUrl" target="_blank" rel="noopener" class="btn btn-outline-primary btn-sm px-3 fw-bold">
                        <i class="fa-solid fa-comments me-1"></i> Chat Zalo
                    </a>
                </div>
            </div>
        </div>
    </section>
}
@section scripts {
    @if (isAdmin)
    {
        <style>
            .js-inline-edit {
                cursor: text;
                outline: 1px dashed transparent;
                outline-offset: 4px;
                border-radius: 4px;
                transition: outline-color .15s, background-color .15s;
            }
            .js-inline-edit:hover,
            .js-inline-edit:focus {
                outline-color: #0d6efd;
                background-color: rgba(13, 110, 253, .06);
            }
            .js-inline-edit.is-saving { outline-color: #ffc107; }
            .js-inline-edit.is-saved { outline-color: #198754; background-color: rgba(25, 135, 84, .08); }
            .js-inline-edit.is-error { outline-color: #dc3545; }
            .admin-inline-hint {
                position: fixed;
                bottom: 16px;
                left: 16px;
                z-index: 1050;
                background: #212529;
                color: #fff;
                font-size: 13px;
                padding: 8px 14px;
                border-radius: 8px;
                box-shadow: 0 4px 16px rgba(0,0,0,.2);
            }
        </style>
        <div class="admin-inline-hint"><i class="fa-solid fa-pen me-1"></i> Admin: click tiêu đề để sửa, click ra ngoài để lưu</div>
    }
    <script>
        $(document).ready(function () {
            if ($('#fleetSlickSlider').length && $.fn.slick) {
                $('#fleetSlickSlider').slick({
                    dots: true,
                    dotsClass: 'fleet-slider-dots',
                    infinite: true,
                    speed: 500,
                    slidesToShow: 3,
                    slidesToScroll: 1,
                    autoplay: true,
                    autoplaySpeed: 3500,
                    pauseOnHover: true,
                    prevArrow: $('#fleetPrevBtn'),
                    nextArrow: $('#fleetNextBtn'),
                    responsive: [
                        {
                            breakpoint: 1200,
                            settings: {
                                slidesToShow: 3,
                                slidesToScroll: 1
                            }
                        },
                        {
                            breakpoint: 992,
                            settings: {
                                slidesToShow: 2,
                                slidesToScroll: 1
                            }
                        },
                        {
                            breakpoint: 576,
                            settings: {
                                slidesToShow: 1,
                                slidesToScroll: 1,
                                arrows: false
                            }
                        }
                    ]
                });
            }

            if ($('#car-img').length && $.fn.slick) {
                $('#car-img').slick({
                    slidesToShow: 1,
                    autoplay: true,
                    autoplaySpeed: 2500,
                    arrows: false,
                    fade: true,
                    asNavFor: '.slider-nav'
                });
                $('.slider-nav').slick({
                    slidesToShow: 4,
                    arrows: false,
                    slidesToScroll: 1,
                    asNavFor: '#car-img',
                    focusOnSelect: true
                });
            }

            if ($('#pricingMobileSlider').length && $.fn.slick) {
                var $pricingSlider = $('#pricingMobileSlider');
                $pricingSlider.slick({
                    dots: false,
                    infinite: true,
                    speed: 300,
                    slidesToShow: 1,
                    slidesToScroll: 1,
                    adaptiveHeight: true,
                    swipe: true,
                    touchThreshold: 10,
                    prevArrow: $('#pricingPrevBtn'),
                    nextArrow: $('#pricingNextBtn')
                });

                $pricingSlider.on('afterChange', function (event, slick, currentSlide) {
                    $('#pricingSliderCounter .current-slide').text(currentSlide + 1);
                    $('#pricingRouteSelect').val(currentSlide);
                });

                $('#pricingRouteSelect').on('change', function () {
                    var idx = parseInt($(this).val(), 10);
                    if (!isNaN(idx)) {
                        $pricingSlider.slick('slickGoTo', idx);
                    }
                });
            }

            // FAQ accordion click toggle
            $(document).on('click', '#homeFaqAccordion .accordion-button', function (e) {
                e.preventDefault();
                var $btn = $(this);
                var targetSelector = $btn.data('bs-target') || $btn.attr('data-bs-target');
                var $target = $(targetSelector);
                if (!$target.length) return;

                var isOpen = $target.hasClass('show');

                // Close other items
                $('#homeFaqAccordion .accordion-collapse').not($target).slideUp(200, function () {
                    $(this).removeClass('show');
                });
                $('#homeFaqAccordion .accordion-button').not($btn).addClass('collapsed').attr('aria-expanded', 'false');

                // Toggle current item
                if (isOpen) {
                    $target.slideUp(200, function () {
                        $target.removeClass('show');
                    });
                    $btn.addClass('collapsed').attr('aria-expanded', 'false');
                } else {
                    $target.slideDown(200, function () {
                        $target.addClass('show');
                    });
                    $btn.removeClass('collapsed').attr('aria-expanded', 'true');
                }
            });

            @if (isAdmin)
            {
                <text>
            function notifyInline(ok, msg) {
                if (typeof $.toast !== 'function') {
                    alert(msg);
                    return;
                }
                $.toast({
                    heading: ok ? 'Thành công' : 'Thất bại',
                    text: msg,
                    icon: ok ? 'success' : 'error',
                    position: 'bottom-right',
                    hideAfter: 2500,
                    stack: 4
                });
            }

            $(document).on('click mousedown', '.js-inline-edit', function (e) {
                e.stopPropagation();
            });

            $(document).on('focus', '.js-inline-edit', function () {
                $(this).data('orig', $(this).text());
            });

            $(document).on('keydown', '.js-inline-edit', function (e) {
                if (e.key === 'Enter' && !e.shiftKey) {
                    e.preventDefault();
                    $(this).blur();
                }
                if (e.key === 'Escape') {
                    $(this).text($(this).data('orig') || '');
                    $(this).blur();
                }
            });

            $(document).on('blur', '.js-inline-edit', function () {
                var $el = $(this);
                var field = $el.data('field');
                var source = $el.data('source') || 'config';
                var id = $el.data('id');
                var value = $.trim($el.text());
                var orig = $el.data('orig');

                if (!field || value === orig) return;

                $el.removeClass('is-saved is-error').addClass('is-saving');
                $.ajax({
                    url: '/mms/sua-nhanh-trang-chu',
                    type: 'POST',
                    data: { source: source, field: field, value: value, id: id },
                    success: function (res) {
                        $el.removeClass('is-saving');
                        if (res && res.status) {
                            $el.data('orig', value).addClass('is-saved');
                            notifyInline(true, 'Đã lưu thay đổi');
                            setTimeout(function () { $el.removeClass('is-saved'); }, 1200);
                        } else {
                            $el.addClass('is-error');
                            notifyInline(false, 'Lưu không thành công. Hãy thử lại');
                        }
                    },
                    error: function () {
                        $el.removeClass('is-saving').addClass('is-error');
                        notifyInline(false, 'Có lỗi kết nối. Hãy thử lại');
                    }
                });
            });
                </text>
            }
        });
    </script>
}