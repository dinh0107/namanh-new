                        var carUrl = Url.Action("ServiceCar", "Home", new { url = car.Slug });
                        
                        <div>
                            <div class="fleet-card-luxury">
                                <div class="fleet-stage">
                                    <img src="@img" alt="@car.Title" loading="lazy" decoding="async" onerror="this.onerror=null;this.src='/Content/images/xe-1.png';" />
