                        var carUrl = Url.Action("ServiceCar", "Home", new { url = car.Slug });
                        
                        <div>
                            <div class="fleet-card-luxury">
                                <div class="fleet-stage">
                                    <img src="@img" alt="@car.Title" />
                                    <div class="fleet-card-header">
                                        <span class="fleet-pill-badge">@capacity</span>
                                        @if (!string.IsNullOrWhiteSpace(car.Slogan))
                                        {
                                            <span class="fleet-tag-pill">
                                                <i class="fa-solid fa-sparkles"></i> @car.Slogan
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="fleet-tag-pill">
                                                <i class="fa-solid fa-sparkles"></i> Đời mới 2024
                                            </span>
                                        }
                                    </div>
                                </div>

                                <div class="fleet-card-body">
                                    <div>
                                        <h3 class="fleet-car-title">@car.Title</h3>
                                        <div class="fleet-car-models" title="@(car.Car ?? car.Title)">
                                            <i class="fa-solid fa-car-side text-primary me-1"></i>
                                            <span>@(car.Car ?? car.Title)</span>
                                        </div>

                                        <div class="fleet-spec-list">
                                            <div class="spec-item">
                                                <i class="fa-solid fa-couch text-primary"></i>
                                                <span><strong>Ghế ngồi:</strong> @(!string.IsNullOrWhiteSpace(car.Capacity) ? car.Capacity : (car.Car ?? car.Title)) êm ái</span>
