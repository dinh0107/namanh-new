                            <div class="col-lg-9">@Html.EditorFor(a => a.HomeCtaDesc)</div>
                        </div>
                        <div class="mb-3 row">
                            @Html.LabelFor(a => a.HomeReviewTitle, new { @class = "col-form-label col-lg-3" })
                            <div class="col-lg-9">@Html.EditorFor(a => a.HomeReviewTitle)</div>
                        </div>
                        <div class="mb-3 row">
                            @Html.LabelFor(a => a.HomeNewsTitle, new { @class = "col-form-label col-lg-3" })
                            <div class="col-lg-9">@Html.EditorFor(a => a.HomeNewsTitle)</div>
                        </div>
                        <div class="mb-3 row">
                            @Html.LabelFor(a => a.HomeNewsDesc, new { @class = "col-form-label col-lg-3" })
                            <div class="col-lg-9">@Html.EditorFor(a => a.HomeNewsDesc)</div>
                        </div>
                        <div class="mb-3 row">
                            @Html.LabelFor(a => a.HomeFaqTitle, new { @class = "col-form-label col-lg-3" })
                            <div class="col-lg-9">@Html.EditorFor(a => a.HomeFaqTitle)</div>
                        </div>
                        <div class="mb-3 row">
                            @Html.LabelFor(a => a.HomeFaqCtaTitle, new { @class = "col-form-label col-lg-3" })
                            <div class="col-lg-9">@Html.EditorFor(a => a.HomeFaqCtaTitle)</div>
                        </div>
                        <div class="mb-3 row">
                            @Html.LabelFor(a => a.HomeFaqCtaDesc, new { @class = "col-form-label col-lg-3" })
                            <div class="col-lg-9">@Html.EditorFor(a => a.HomeFaqCtaDesc)</div>
                        </div>
                        <hr />
                        <div class="mb-3 row">
                            @Html.LabelFor(a => a.InfoContact, new { @class = "col-form-label col-lg-3" })
                            <div class="col-lg-9">@Html.EditorFor(a => a.InfoContact)</div>
                        </div>
                        <div class="mb-3 row">
                            @Html.LabelFor(a => a.InfoFooter, new { @class = "col-form-label col-lg-3" })
                            <div class="col-lg-9">@Html.EditorFor(a => a.InfoFooter)</div>
                        </div>
                        <div class="mb-3 row">
                            @Html.LabelFor(a => a.Place, new { @class = "col-form-label col-lg-3" })
                            <div class="col-lg-9">@Html.EditorFor(a => a.Place)</div>
                        </div>
                        <div class="mb-3 row">
                            @Html.LabelFor(a => a.Zalo, new { @class = "col-form-label col-lg-3" })
                            <div class="col-lg-9">@Html.EditorFor(a => a.Zalo)</div>
                        </div>
                        <div class="mb-3 row">
                            @Html.LabelFor(a => a.Hotline, new { @class = "col-form-label col-lg-3" })
                            <div class="col-lg-9">@Html.EditorFor(a => a.Hotline)</div>
                        </div>
                        @*<div class="mb-3 row">
                @Html.LabelFor(a => a.Hotline2, new { @class = "col-form-label col-lg-3" })
                <div class="col-lg-9">@Html.EditorFor(a => a.Hotline2)</div>
            </div>*@
                        <div class="mb-3 row">
                            <label class="col-form-label col-lg-3" for="Email">Email nhận thông báo / hiển thị</label>
                            <div class="col-lg-9">
                                @Html.EditorFor(a => a.Email)
                                <div class="form-text text-muted">Email khách/admin nhận đơn đặt xe (footer cũng dùng email này).</div>
                            </div>
                        </div>
                        <div class="mb-3 row">
                            <label class="col-form-label col-lg-3" for="SmtpEmail">Email SMTP (Gmail gửi)</label>
                            <div class="col-lg-9">
                                <input type="email" name="SmtpEmail" id="SmtpEmail" class="form_control w300" value="@(ViewBag.SmtpEmail as string)" placeholder="vd: your@gmail.com" />
                                <div class="form-text text-muted">Tài khoản Gmail dùng để <strong>gửi</strong> mail thông báo đặt xe.</div>
                            </div>
                        </div>
                        <div class="mb-3 row">
                            <label class="col-form-label col-lg-3" for="SmtpPassword">Mật khẩu ứng dụng Gmail</label>
                            <div class="col-lg-9">
                                <input type="password" name="SmtpPassword" id="SmtpPassword" class="form_control w300" value="" autocomplete="new-password" placeholder="Để trống = giữ mật khẩu cũ" />
                                <div class="form-text text-muted">App password 16 ký tự (Google Account → Bảo mật → Mật khẩu ứng dụng). Để trống nếu không đổi.</div>
                            </div>
                        </div>
                        <div class="mb-3 row">
                            @Html.LabelFor(a => a.Facebook, new { @class = "col-form-label col-lg-3" })
                            <div class="col-lg-9">@Html.EditorFor(a => a.Facebook)</div>
                        </div>
                        <div class="mb-3 row">
                            @Html.LabelFor(a => a.Messenger, new { @class = "col-form-label col-lg-3" })
                            <div class="col-lg-9">@Html.EditorFor(a => a.Messenger)</div>
                        </div>
                        <div class="mb-3 row">
                            @Html.LabelFor(a => a.Instagram, new { @class = "col-form-label col-lg-3" })
                            <div class="col-lg-9">@Html.EditorFor(a => a.Instagram)</div>
                        </div>
                        <div class="mb-3 row">
                            @Html.LabelFor(a => a.Youtube, new { @class = "col-form-label col-lg-3" })
                            <div class="col-lg-9">@Html.EditorFor(a => a.Youtube)</div>
                        </div>
                        <div class="mb-3 row">
                            @Html.LabelFor(a => a.GoogleMap, new { @class = "col-form-label col-lg-3" })
                            <div class="col-lg-9">@Html.EditorFor(a => a.GoogleMap)</div>
                        </div>
                        <div class="mb-3 row">
                            @Html.LabelFor(a => a.GoogleAnalytics, new { @class = "col-form-label col-lg-3" })
                            <div class="col-lg-9">@Html.EditorFor(a => a.GoogleAnalytics)</div>
                        </div><div class="btn-group">
                            <button type="submit" class="btn-main btn-primary text-white ms-3">
                                <span>Lưu</span>
                                <i class="fa-solid fa-floppy-disk ms-2"></i>
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>