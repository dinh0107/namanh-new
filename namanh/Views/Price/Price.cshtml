@model namanh.Models.PriceLangding
@{
    ViewBag.Title = "Thêm tuyến bảng giá";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<div class="page-header">
    <div class="page-title">
        <i class="fa-solid fa-align-right fa-rotate-180 fa-sm"></i>
        <span>Thêm tuyến bảng giá</span>
    </div>
    <a href="@Url.Action("List")" class="btn-main btn-labeled bg-brown">
        <span class="icon">
            <i class="fa-solid fa-left"></i>
        </span>
        Quay lại
    </a>
</div>
<div class="content">
    <div class="accordion">
        <div class="accordion-item border-left-slate">
            <div class="accordion-header">
                <div class="card-title">
                    <i class="fa-light fa-octagon-plus fa-lg"></i>
                    Thêm tuyến
                </div>
                <button type="button" data-bs-toggle="collapse" data-bs-target="#createForm" aria-expanded="true">
                    <i class="fa-solid fa-angle-down"></i>
                </button>
            </div>
            <div id="createForm" class="accordion-collapse collapse show">
                <div class="accordion-body">
                    @using (Html.BeginForm("Price", "Price", FormMethod.Post, new { @id = "data-insert-form" }))
                    {
                        @Html.ValidationSummary(true)
                        <div class="mb-3 row">
                            <label class="col-form-label col-lg-3">Tên tuyến / điểm đi <span class="text-danger">*</span></label>
                            <div class="col-lg-9">@Html.EditorFor(a => a.Name)</div>
                        </div>
                        <div class="mb-3 row">
                            <label class="col-form-label col-lg-3">Mô tả</label>
                            <div class="col-lg-9">@Html.EditorFor(a => a.Description)</div>
                        </div>
                        <div class="mb-3 row">
                            <label class="col-form-label col-lg-3">Danh sách điểm đến &amp; giá</label>
                            <div class="col-lg-9">
                                @Html.Partial("_LocationPriceFields", Model)
                            </div>
                        </div>
                        <div class="mb-3 row">
                            @Html.LabelFor(a => a.Sort, new { @class = "col-form-label col-lg-3" })
                            <div class="col-lg-9">@Html.EditorFor(a => a.Sort)</div>
                        </div>
                        <div class="mb-3 row">
                            @Html.LabelFor(a => a.Active, new { @class = "col-form-label col-lg-3" })
                            <div class="col-lg-9">
                                <label class="form-check-label">
                                    @Html.CheckBoxFor(a => a.Active)
                                </label>
                            </div>
                        </div>
                        <div class="btn-group">
                            <button type="submit" class="btn-main btn-primary text-white">
                                <span>Lưu</span>
                                <i class="fa-solid fa-floppy-disk ms-2"></i>
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
@section scripts {
    <script>
        var locationIndex = 1;

        function locationRowHtml(index, withAdd) {
            var actionBtn = withAdd
                ? '<button type="button" class="btn btn-success btn-sm add-location"><i class="fa-solid fa-plus"></i></button>'
                : '<button type="button" class="btn btn-danger btn-sm remove-location"><i class="fa-solid fa-minus"></i></button>';

            return '<tr class="location-item">' +
                '<td><input type="text" name="Locations[' + index + '].Name" class="form_control" placeholder="VD: Lào Cai" /></td>' +
                '<td><input type="text" name="Locations[' + index + '].Price4" class="form_control" placeholder="1.000.000 đ" /></td>' +
                '<td><input type="text" name="Locations[' + index + '].Price7" class="form_control" /></td>' +
                '<td><input type="text" name="Locations[' + index + '].Price16" class="form_control" /></td>' +
                '<td><input type="text" name="Locations[' + index + '].Price29" class="form_control" /></td>' +
                '<td><input type="text" name="Locations[' + index + '].Price45" class="form_control" /></td>' +
                '<td><input type="text" name="Locations[' + index + '].PriceLim" class="form_control" /></td>' +
                '<td><input type="number" name="Locations[' + index + '].Sort" value="' + (index + 1) + '" class="form_control" style="width:70px" /></td>' +
                '<td class="text-center"><input type="hidden" name="Locations[' + index + '].Hot" value="false" /><input type="checkbox" name="Locations[' + index + '].Hot" value="true" /></td>' +
                '<td class="text-center"><input type="hidden" name="Locations[' + index + '].Active" value="true" />' + actionBtn + '</td>' +
                '</tr>';
        }

        $(document).on('click', '.add-location', function () {
            $('#location-wrapper').append(locationRowHtml(locationIndex, false));
            locationIndex++;
        });

        $(document).on('click', '.remove-location', function () {
            $(this).closest('.location-item').remove();
        });
    </script>
}
