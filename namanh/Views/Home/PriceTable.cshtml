@model namanh.ViewModel.HomeViewModel
@using namanh.Models
@{
    var config = (ConfigSite)HttpContext.Current.Application["ConfigSite"];
}
<section class="page-section price-section">
    <img src="~/Content/images/bg-price.jpg" alt="Anh" class="price-bg"/>
    <h2 class="title">bảng giá dịch vụ minh bạch </h2>
    @*<p class="sub-title  mb-4">
        Bảng giá mang tính tham khảo — vui lòng liên hệ để nhận báo giá tốt nhất theo lộ trình của bạn.
    </p>*@
    <div class="container">
        <div class="d-flex justify-content-center">
            <div class="btn-group filer-btn row" role="group" aria-label="Basic example">
                <div class="col-4">
                    <button type="button" id="btn-4cho" class="btn active col-4">4 chỗ</button>
                </div>
                <div class="col-4">
                    <button type="button" id="btn-7cho" class="btn  col-4">7 chỗ</button>
                </div>
                <div class="col-4">
                    <button type="button" id="btn-16cho" class="btn col-4">16 chỗ</button>
                </div>
                <div class="col-4">
                    <button type="button" id="btn-29cho" class="btn col-4">29 chỗ</button>
                </div>
                <div class="col-4">
                    <button type="button" id="btn-45cho" class="btn col-4">45 chỗ</button>
                </div>
                <div class="col-4">
                    <button type="button" id="btn-Limousine" class="btn col-4">Limousine</button>
                </div>
            </div>
        </div>
        <div class="box-price">
            <table id="priceTable" class="table table-bordered">
                <thead>
                    <tr>
                        <th>Hành trình</th>
                        <th id="priceHeader"><span class="d-block pb-2">Giá</span></th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
            <table class="table table-bordered" id="myTable">
                <thead class="header-tb">
                    <tr>
                        <td scope="col" style="width:247px">Hành trình</td>
                        <td scope="col">4 chỗ</td>
                        <td scope="col">7 chỗ</td>
                        <td scope="col">16 chỗ</td>
                        <td scope="col">29 chỗ</td>
                        <td scope="col">45 chỗ</td>
                        <td scope="col">Limousine</td>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.PriceTables)
                    {
                        var hot = item.Hot ? "class=hot" : "";
                        var hotImg = item.Hot ? "<img src=\"/Content/images/hot-gif.gif\" width=\"30\" height=\"30\" alt=\"Hot\" />" : "";

                        <tr @hot>
                            <td scope="row" >@item.RouteDescription @Html.Raw(hotImg)</td>
                            <td>@item.Price4</td>
                            <td>@item.Price7</td>
                            <td>@item.Price16</td>
                            <td>@item.Price29</td>
                            <td>@item.Price45</td>
                            <td>@item.PriceLim</td>
                        </tr>
                    }
                </tbody>
            </table>
            
        </div>
        <div class="d-flex justify-content-center pb-2">
            <div id="show-more-table" class="btn-color">
                xem bảng giá đầy đủ
                <div class="box-icon">
                    <i class="far fa-long-arrow-right"></i>
                </div>
            </div>
            <a href="https://zalo.me/@config.Zalo" id="show-call-table" class="btn-color">
                Nhận báo giá chính xác
            </a>
        </div>
    </div>
</section>