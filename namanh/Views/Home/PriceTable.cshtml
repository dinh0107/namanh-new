@model namanh.ViewModel.HomeViewModel
@using namanh.Models
@{
    var config = (ConfigSite)HttpContext.Current.Application["ConfigSite"];
}
<section class="page-section price-section">
    <img src="~/Content/images/bg-price.jpg" alt="Anh" class="price-bg" />
    <h2 class="title">bảng giá dịch vụ minh bạch </h2>
    @*<p class="sub-title  mb-4">
            Bảng giá mang tính tham khảo — vui lòng liên hệ để nhận báo giá tốt nhất theo lộ trình của bạn.
        </p>*@
    <div class="container">
        <div class="d-flex justify-content-center">
            <div class="btn-group filer-btn row" role="group" aria-label="Basic example">
                <div class="col-4">
                    <button type="button" id="btn-4cho" class="btn active col-4">4 chỗ</button>
                </div>
                <div class="col-4">
                    <button type="button" id="btn-7cho" class="btn  col-4">7 chỗ</button>
                </div>
                <div class="col-4">
                    <button type="button" id="btn-16cho" class="btn col-4">16 chỗ</button>
                </div>
                <div class="col-4">
                    <button type="button" id="btn-29cho" class="btn col-4">29 chỗ</button>
                </div>
                <div class="col-4">
                    <button type="button" id="btn-45cho" class="btn col-4">45 chỗ</button>
                </div>
                <div class="col-4">
                    <button type="button" id="btn-Limousine" class="btn col-4">Limousine</button>
                </div>
            </div>
        </div>
        <div class="box-price">
            <div class="price-slick">
                @foreach (var item in Model.PriceLangdings)
                {
                    <div class="car-card">
                        <div class="card-header">
                            <div class="seat">
                               @item.Name
                            </div>
                        </div>

                        <div class="card-body">
                            <div class="title-card">
                                Tuyến đường phổ biến
                            </div>

                            <div class="location-list">
                                @foreach (var loc in item.Locations.Take(5))
                                {
                                    <div class="location-item">@loc.Name</div>
                                }
                            </div>

                            <ul class="feature-list">
                                <li><i class="fa fa-check"></i> Xe sạch sẽ đời mới</li>
                                <li><i class="fa fa-check"></i> Tài xế chuyên nghiệp</li>
                                <li><i class="fa fa-check"></i> Đưa đón tận nơi</li>
                                <li><i class="fa fa-check"></i> Hỗ trợ 24/7</li>
                            </ul>

                            <a href="@config.Zalo" class="btn-book">
                                Đặt xe ngay
                            </a>

                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>