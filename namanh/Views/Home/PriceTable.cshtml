@model namanh.ViewModel.HomeViewModel
@using namanh.Models
@{
    var config = (ConfigSite)HttpContext.Current.Application["ConfigSite"];
    var tabs = Model.PriceLangdings?.Where(a => a.Active).OrderBy(a => a.Sort).ToList() ?? new List<PriceLangding>();
}

@if (tabs.Any())
{
    <section class="page-section price-routes-section">
        <div class="container">
            <div class="price-routes-head">
                <h2 class="price-routes-title">Các tuyến đường phổ biến</h2>
                <p class="price-routes-sub">Bảng giá tham khảo theo loại xe — liên hệ hotline để nhận báo giá tốt nhất</p>
            </div>

            <div class="price-car-filter" role="group" aria-label="Loại xe">
                <button type="button" class="price-car-btn active" data-car="_4_cho">4 chỗ</button>
                <button type="button" class="price-car-btn" data-car="_7_cho">7 chỗ</button>
                <button type="button" class="price-car-btn" data-car="_16_cho">16 chỗ</button>
                <button type="button" class="price-car-btn" data-car="_29_cho">29 chỗ</button>
                <button type="button" class="price-car-btn" data-car="_45_cho">45 chỗ</button>
                <button type="button" class="price-car-btn" data-car="limousine">Limousine</button>
            </div>

            <div class="price-routes-box">
                <ul class="price-route-tabs">
                    @{
                        var tabIndex = 0;
                    }
                    @foreach (var tab in tabs)
                    {
                        <li>
                            <button type="button"
                                    class="price-route-tab @(tabIndex == 0 ? "active" : "")"
                                    data-tab="@tab.Id">
                                @tab.Name
                            </button>
                        </li>
                        tabIndex++;
                    }
                </ul>

                @{
                    tabIndex = 0;
                }
                @foreach (var tab in tabs)
                {
                    var routes = tab.Locations?.Where(l => l.Active).OrderBy(l => l.Sort).ToList() ?? new List<Location>();
                    <div class="price-route-panel @(tabIndex == 0 ? "active" : "")" data-panel="@tab.Id">
                        @if (routes.Any())
                        {
                            <ul class="price-route-list">
                                @foreach (var route in routes)
                                {
                                    <li class="price-route-item @(route.Hot ? "is-hot" : "")"
                                        data-p4="@(route.Price4 ?? "")"
                                        data-p7="@(route.Price7 ?? "")"
                                        data-p16="@(route.Price16 ?? "")"
                                        data-p29="@(route.Price29 ?? "")"
                                        data-p45="@(route.Price45 ?? "")"
                                        data-plim="@(route.PriceLim ?? "")">
                                        <div class="price-route-info">
                                            <h3>
                                                @tab.Name
                                                <i class="fa-regular fa-arrow-right-long"></i>
                                                @route.Name
                                                <span class="price-route-return">| Ngược lại</span>
                                            </h3>
                                            @if (route.Hot)
                                            {
                                                <img src="~/Content/images/hot-gif.gif" width="28" height="28" alt="Hot" class="price-route-hot" />
                                            }
                                        </div>
                                        <div class="price-route-value">
                                            <span class="price-route-price">@(string.IsNullOrWhiteSpace(route.Price4) ? "Liên hệ" : route.Price4)</span>
                                        </div>
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <p class="price-route-empty">Chưa có tuyến đường cho khu vực này.</p>
                        }
                    </div>
                    tabIndex++;
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(config?.Hotline))
            {
                <div class="price-routes-cta text-center">
                    <a href="tel:@config.Hotline" class="btn-color">
                        Liên hệ báo giá: @config.Hotline
                    </a>
                </div>
            }
        </div>
    </section>
}
