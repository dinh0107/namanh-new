@model namanh.ViewModel.HeaderViewModel
@using namanh.Models
@{
    var config = (ConfigSite)HttpContext.Current.Application["ConfigSite"];
    var logoUrl = config?.Image != null ? Path.Combine("/images/configs/", config.Image) : null;
    var siteTitle = config?.Title ?? "Trang chủ";
    var hotline = config?.Hotline;
    var email = config?.Email;
    var articleParents = Model.ArticleCategories
        .Where(a => a.TypePost == TypePost.Article && a.ParentId == null)
        .ToList();
    var serviceUrl = Model.Services.Any()
        ? Url.Action("ServiceCar", "Home", new { url = Model.Services.First().Slug })
        : "javascript:void(0);";
    var newsUrl = articleParents.Any()
        ? GetCategoryUrl(articleParents.First())
        : "javascript:void(0);";
}

@functions {
    string GetCategoryUrl(ArticleCategory category)
    {
        if (category.Redirect)
        {
            return category.Url;
        }
        return Url.Action("ArticleCategory", "Home", new { url = category.Url });
    }
}

<section class="masthead" id="masthead">
    <div class="container">
        <div class="d-flex align-items-center justify-content-between">
            <a href="/" class="logo">
                @if (logoUrl != null)
                {
                    <img class="img-fluid" src="@logoUrl" alt="@siteTitle" />
                }
            </a>
            <div class="icon-boxs d-flex">
                @if (!string.IsNullOrWhiteSpace(hotline))
                {
                    <div class="icon-box">
                        <div class="icon-img">
                            <i class="fa-solid fa-phone-volume"></i>
                        </div>
                        <div class="icon-text">
                            <p>Gọi cho chúng tôi ngay</p>
                            <a href="tel:@hotline">@hotline</a>
                        </div>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(email))
                {
                    <div class="icon-box">
                        <div class="icon-img">
                            <i class="fa-solid fa-envelope"></i>
                        </div>
                        <div class="icon-text">
                            <p>Gửi email ngay bây giờ</p>
                            <a href="mailto:@email">@email</a>
                        </div>
                    </div>
                }
            </div>
        </div>
        <div class="wide-nav">
            <div class="container">
                <div class="row">
                    <div class="col-4"></div>
                    <div class="col-8">
                        @Html.Partial("_HeaderNav", Model)
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="header-sticky" id="header-sticky">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-3">
                <a href="/" class="logo">
                    @if (logoUrl != null)
                    {
                        <img src="@logoUrl" alt="@siteTitle" />
                    }
                </a>
            </div>
            <div class="col-lg-9">
                @Html.Partial("_HeaderNav", Model)
            </div>
        </div>
    </div>
</section>

<section class="header-mb">
    <a href="/" class="logo">
        @if (logoUrl != null)
        {
            <img src="@logoUrl" alt="@siteTitle" />
        }
    </a>
    <div class="menu-btn">
        <i class="fa-solid fa-bars fa-lg"></i>
    </div>
</section>

<section class="menu-drawer">
    <div class="menu-header">
        @if (logoUrl != null)
        {
            <img src="@logoUrl" alt="@siteTitle" />
        }
        <div class="menu-close" onclick="toggleMenu()">
            <i class="fa-solid fa-times fa-lg"></i>
        </div>
    </div>
    <a href="/" class="menu-link">
        <i class="fa-solid fa-home"></i>
        Trang chủ
    </a>
    <a href="@Url.Action("Introduct")" class="menu-link">
        <i class="fa-solid fa-user-group"></i>
        Về chúng tôi
    </a>
    <div class="menu-item has-children">
        <a href="@serviceUrl" class="menu-link">
            <i class="fa-solid fa-car"></i>
            Dịch vụ
        </a>
        @if (Model.Services.Any())
        {
            <span class="expand-bar"></span>
            <div class="menu-children">
                @foreach (var service in Model.Services)
                {
                    <a href="@Url.Action("ServiceCar", "Home", new { url = service.Slug })" class="menu-child-link">@service.Title</a>
                }
            </div>
        }
    </div>
    @if (articleParents.Any())
    {
        var newsChildren = articleParents
            .SelectMany(p => Model.ArticleCategories.Where(c => c.ParentId == p.Id))
            .ToList();
        if (!newsChildren.Any())
        {
            newsChildren = articleParents;
        }
        <div class="menu-item@(newsChildren.Any() ? " has-children" : "")">
            <a href="@newsUrl" class="menu-link">
                <i class="fa-solid fa-newspaper"></i>
                Tin tức
            </a>
            @if (newsChildren.Any())
            {
                <span class="expand-bar"></span>
                <div class="menu-children">
                    @foreach (var child in newsChildren)
                    {
                        <a href="@GetCategoryUrl(child)" class="menu-child-link">@child.CategoryName</a>
                    }
                </div>
            }
        </div>
    }
    <a href="@Url.Action("Contact")" class="menu-link">
        <i class="fa-solid fa-phone"></i>
        Liên hệ
    </a>
    @if (!string.IsNullOrWhiteSpace(hotline))
    {
        <div class="menu-hotline-box">
            <div class="menu-hotline-title">Hotline</div>
            <a href="tel:@hotline" class="menu-hotline-number">@hotline</a>
        </div>
    }
</section>

<div class="menu-overlay"></div>
