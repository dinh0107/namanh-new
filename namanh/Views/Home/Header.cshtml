@model namanh.ViewModel.HeaderViewModel
@using namanh.Models
@{
    var config = (ConfigSite)HttpContext.Current.Application["ConfigSite"];
    var logoUrl = config?.Image != null ? Path.Combine("/images/configs/", config.Image) : null;
    var siteTitle = config?.Title ?? "Trang chủ";
    var hotline = config?.Hotline;
    var email = config?.Email;
    var articleParents = Model.ArticleCategories
        .Where(a => a.TypePost == TypePost.Article && a.ParentId == null)
        .ToList();
    var serviceUrl = Model.Services.Any()
        ? Url.Action("ServiceCar", "Home", new { url = Model.Services.First().Slug })
        : "javascript:void(0);";
    var newsUrl = articleParents.Any()
        ? GetCategoryUrl(articleParents.First())
        : "javascript:void(0);";
    var newsChildren = articleParents
        .SelectMany(p => Model.ArticleCategories.Where(c => c.ParentId == p.Id))
        .ToList();
    if (!newsChildren.Any())
    {
        newsChildren = articleParents;
    }
}

@functions {
    string GetCategoryUrl(ArticleCategory category)
    {
        if (category.Redirect)
        {
            return category.Url;
        }
        return Url.Action("ArticleCategory", "Home", new { url = category.Url });
    }
}

<section class="site-header" id="site-header">
    <div class="site-header-top">
        <div class="container">
            <div class="site-header-top-inner">
                <a href="/" class="site-logo">
                    @if (logoUrl != null)
                    {
                        <img src="@logoUrl" alt="@siteTitle" />
                    }
                </a>
                <div class="site-header-contact">
                    @if (!string.IsNullOrWhiteSpace(hotline))
                    {
                        <div class="contact-item">
                            <div class="contact-icon">
                                <i class="fa-solid fa-phone-volume"></i>
                            </div>
                            <div class="contact-text">
                                <p>Gọi cho chúng tôi ngay</p>
                                <a href="tel:@hotline">@hotline</a>
                            </div>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(email))
                    {
                        <div class="contact-item">
                            <div class="contact-icon">
                                <i class="fa-solid fa-envelope"></i>
                            </div>
                            <div class="contact-text">
                                <p>Gửi email ngay bây giờ</p>
                                <a href="mailto:@email">@email</a>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
    <div class="site-header-nav d-none d-lg-block">
        <div class="container">
            @Html.Partial("_HeaderNav", Model)
        </div>
    </div>
</section>

<section class="site-header-sticky" id="site-header-sticky">
    <div class="container">
        <div class="site-header-sticky-inner">
            <a href="/" class="site-logo">
                @if (logoUrl != null)
                {
                    <img src="@logoUrl" alt="@siteTitle" />
                }
            </a>
            <div class="d-none d-lg-block">
                @Html.Partial("_HeaderNav", Model)
            </div>
            @if (!string.IsNullOrWhiteSpace(hotline))
            {
                <a href="tel:@hotline" class="site-header-cta d-none d-lg-inline-flex">
                    <i class="fa-solid fa-phone"></i>
                    Đặt xe ngay
                </a>
            }
            <button type="button" class="site-menu-btn d-lg-none" aria-label="Mở menu">
                <i class="fa-solid fa-bars"></i>
            </button>
        </div>
    </div>
</section>

<section class="site-menu-drawer" aria-hidden="true">
    <div class="site-menu-head">
        @if (logoUrl != null)
        {
            <img src="@logoUrl" alt="@siteTitle" />
        }
        <button type="button" class="site-menu-close" onclick="toggleMenu()" aria-label="Đóng menu">
            <i class="fa-solid fa-times"></i>
        </button>
    </div>
    <a href="/" class="site-menu-link">
        <i class="fa-solid fa-home"></i>
        Trang chủ
    </a>
    <a href="@Url.Action("Introduct")" class="site-menu-link">
        <i class="fa-solid fa-user-group"></i>
        Về chúng tôi
    </a>
    <div class="site-menu-group@(Model.Services.Any() ? " has-children" : "")">
        <a href="@serviceUrl" class="site-menu-link">
            <i class="fa-solid fa-car"></i>
            Dịch vụ
        </a>
        @if (Model.Services.Any())
        {
            <button type="button" class="site-menu-expand" aria-label="Mở danh mục dịch vụ"></button>
            <div class="site-menu-children">
                @foreach (var service in Model.Services)
                {
                    <a href="@Url.Action("ServiceCar", "Home", new { url = service.Slug })" class="site-menu-child">@service.Title</a>
                }
            </div>
        }
    </div>
    @if (articleParents.Any())
    {
        <div class="site-menu-group@(newsChildren.Any() ? " has-children" : "")">
            <a href="@newsUrl" class="site-menu-link">
                <i class="fa-solid fa-newspaper"></i>
                Tin tức
            </a>
            @if (newsChildren.Any())
            {
                <button type="button" class="site-menu-expand" aria-label="Mở danh mục tin tức"></button>
                <div class="site-menu-children">
                    @foreach (var child in newsChildren)
                    {
                        <a href="@GetCategoryUrl(child)" class="site-menu-child">@child.CategoryName</a>
                    }
                </div>
            }
        </div>
    }
    <a href="@Url.Action("Contact")" class="site-menu-link">
        <i class="fa-solid fa-phone"></i>
        Liên hệ
    </a>
    @if (!string.IsNullOrWhiteSpace(hotline))
    {
        <div class="site-menu-hotline">
            <div class="site-menu-hotline-label">Hotline</div>
            <a href="tel:@hotline">@hotline</a>
        </div>
    }
</section>

<div class="site-menu-overlay"></div>
