@model namanh.ViewModel.HeaderViewModel
@using namanh.Models
@{
    var articleParents = Model.ArticleCategories
        .Where(a => a.TypePost == TypePost.Article && a.ParentId == null)
        .ToList();
    var serviceUrl = Model.Services.Any()
        ? Url.Action("ServiceCar", "Home", new { url = Model.Services.First().Slug })
        : "javascript:void(0);";
    var newsUrl = articleParents.Any()
        ? GetCategoryUrl(articleParents.First())
        : "javascript:void(0);";
    var newsChildren = articleParents
        .SelectMany(p => Model.ArticleCategories.Where(c => c.ParentId == p.Id))
        .ToList();
    if (!newsChildren.Any())
    {
        newsChildren = articleParents.ToList();
    }
}

@functions {
    string GetCategoryUrl(ArticleCategory category)
    {
        if (category.Redirect)
        {
            return category.Url;
        }
        return Url.Action("ArticleCategory", "Home", new { url = category.Url });
    }
}

<ul class="nav ul-reset">
    <li>
        <a href="/">Trang chủ</a>
    </li>
    <li>
        <a href="@Url.Action("Introduct")">Về chúng tôi</a>
    </li>
    <li>
        <a href="@serviceUrl">Dịch vụ</a>
        @if (Model.Services.Any())
        {
            <i class="fa-regular fa-angle-right"></i>
            <div class="drop">
                <ul class="sub-nav ul-reset">
                    @foreach (var service in Model.Services)
                    {
                        <li>
                            <a href="@Url.Action("ServiceCar", "Home", new { url = service.Slug })">@service.Title</a>
                        </li>
                    }
                </ul>
            </div>
        }
    </li>
    @if (articleParents.Any())
    {
        <li>
            <a href="@newsUrl">Tin tức</a>
            @if (newsChildren.Any())
            {
                <i class="fa-regular fa-angle-right"></i>
                <div class="drop">
                    <ul class="sub-nav ul-reset">
                        @foreach (var child in newsChildren)
                        {
                            <li>
                                <a href="@GetCategoryUrl(child)">@child.CategoryName</a>
                            </li>
                        }
                    </ul>
                </div>
            }
        </li>
    }
    <li>
        <a href="@Url.Action("Contact")">Liên hệ</a>
    </li>
</ul>
