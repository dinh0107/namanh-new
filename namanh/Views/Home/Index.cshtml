@using namanh.Models
@model namanh.ViewModel.HomeViewModel
@{
    var config = (ConfigSite)HttpContext.Current.Application["ConfigSite"];
    var siteTitle = config?.Title ?? "Hà Linh - Cho thuê xe có lái";
    ViewBag.Title = siteTitle;
    ViewBag.Description = config?.Description;
    ViewBag.Canonical = Request.Url?.GetLeftPart(UriPartial.Authority) + Url.Action("Index");
    var share = config?.ImageShare ?? config?.Image;
    if (share != null)
    {
        ViewBag.ImageShare = Request.Url?.GetLeftPart(UriPartial.Authority) + Path.Combine("/images/configs/", share);
    }
    var hotline = config?.Hotline ?? "1900 8866";
    var zaloUrl = !string.IsNullOrWhiteSpace(config?.Zalo) ? "https://zalo.me/" + config.Zalo.Trim() : ("tel:" + hotline);

    // Editable Hero Banner (GroupId = 1)
    var heroBanner = Model?.Banners?.FirstOrDefault(b => b.GroupId == 1 && b.Active);
    var heroBadge = !string.IsNullOrWhiteSpace(heroBanner?.Content) ? heroBanner.Content : "Uy tín – An toàn – Tận tâm";
    var heroTitle = !string.IsNullOrWhiteSpace(heroBanner?.BannerName) ? heroBanner.BannerName : "Cho thuê xe có lái – Xe đẹp, tài xế chuyên nghiệp, báo giá nhanh";
    var heroDesc = !string.IsNullOrWhiteSpace(heroBanner?.Slogan) ? heroBanner.Slogan : (config?.Description ?? "Cung cấp dịch vụ thuê xe du lịch, đưa đón sân bay, công tác, cưới hỏi, đi tỉnh... với đội xe đời mới, sạch đẹp và tài xế giàu kinh nghiệm.");
    var heroImg = !string.IsNullOrWhiteSpace(heroBanner?.Image)
        ? (heroBanner.Image.StartsWith("http") ? heroBanner.Image : Url.Content("~/images/banners/" + heroBanner.Image))
        : (!string.IsNullOrWhiteSpace(config?.AboutImage) ? Url.Content("~/images/configs/" + config.AboutImage) : "https://lh3.googleusercontent.com/aida-public/AB6AXuC__i21Wh1UkG1m7MvdXP_pp07pp56ss_ADvcowbOIM5uBngiWjp2yCBAjQxxwoc88U82Tpc7mqMbpr0-BYa0Z1f0yahWSlMkWBeJ2WpqCdlmBAmtQ-Mj3LjmhFPh145BGFWTtYQQx66YTiZ7G8IvXYoKRQCGp_Z740f8bwVDo3Zx511_jAN5KFer0kpRBEdO2GtZ04LVoLG0M9V1MlnYNxOcMjRJTWzeptgQEsPa31fVrkh6vGNqy34g");

    // Editable Vehicle Fleet
    var services = Model?.Services?.ToList() ?? new List<CarService>();

    // Editable Routes & Prices
    var priceLangdings = Model?.PriceLangdings?.ToList() ?? new List<PriceLangding>();

    // Editable Testimonials / Reviews (GroupId = 2)
    var reviews = Model?.Banners?.Where(b => b.GroupId == 2 && b.Active).OrderBy(b => b.Sort).ToList() ?? new List<Banner>();

    // Editable Articles
    var articles = Model?.Articles?.ToList() ?? new List<Article>();

    // Editable FAQs (GroupId = 4)
    var faqs = Model?.Banners?.Where(b => b.GroupId == 4 && b.Active).OrderBy(b => b.Sort).ToList() ?? new List<Banner>();

    // Section titles (ConfigSite)
    var fleetTitle = !string.IsNullOrWhiteSpace(config?.HomeFleetTitle) ? config.HomeFleetTitle : "Các dòng xe đang cho thuê";
    var fleetDesc = !string.IsNullOrWhiteSpace(config?.HomeFleetDesc) ? config.HomeFleetDesc : "Đa dạng lựa chọn từ 4 chỗ đến 45 chỗ và Limousine cao cấp đời mới";
    var priceTitle = !string.IsNullOrWhiteSpace(config?.HomePriceTitle) ? config.HomePriceTitle : "Bảng giá tham khảo tuyến đường phổ biến";
    var priceDesc = !string.IsNullOrWhiteSpace(config?.HomePriceDesc) ? config.HomePriceDesc : "Bấm vào bất kỳ tuyến đường hoặc mức giá nào để tự động điền form và nhận báo giá chi tiết!";
    var priceNoteTitle = !string.IsNullOrWhiteSpace(config?.HomePriceNoteTitle) ? config.HomePriceNoteTitle : "Ghi chú bảng giá";
    var ctaTitle = !string.IsNullOrWhiteSpace(config?.HomeCtaTitle) ? config.HomeCtaTitle : "NHẬN BÁO GIÁ TỐT NHẤT NGAY";
    var ctaDesc = !string.IsNullOrWhiteSpace(config?.HomeCtaDesc) ? config.HomeCtaDesc : "Bấm để điền thông tin và nhận ưu đãi giảm giá hôm nay";
    var reviewTitle = !string.IsNullOrWhiteSpace(config?.HomeReviewTitle) ? config.HomeReviewTitle : "Khách hàng nói gì về chúng tôi?";
    var newsTitle = !string.IsNullOrWhiteSpace(config?.HomeNewsTitle) ? config.HomeNewsTitle : "Tin tức & Cẩm nang du lịch";
    var newsDesc = !string.IsNullOrWhiteSpace(config?.HomeNewsDesc) ? config.HomeNewsDesc : "Kinh nghiệm thuê xe, thông tin các tuyến đường và cẩm nang du lịch hữu ích";
    var faqTitle = !string.IsNullOrWhiteSpace(config?.HomeFaqTitle) ? config.HomeFaqTitle : "Câu hỏi thường gặp";
    var faqCtaTitle = !string.IsNullOrWhiteSpace(config?.HomeFaqCtaTitle) ? config.HomeFaqCtaTitle : "Bạn còn câu hỏi nào khác?";
    var faqCtaDesc = !string.IsNullOrWhiteSpace(config?.HomeFaqCtaDesc) ? config.HomeFaqCtaDesc : "Đội ngũ chuyên viên của chúng tôi luôn sẵn sàng hỗ trợ và tư vấn 24/7";

    var isAdmin = Request.IsAuthenticated;
    Func<string, string, int?, string> EditAttrs = (field, source, id) =>
    {
        if (!isAdmin) return "";
        if (source == "banner" && !id.HasValue) return "";
        var attrs = " contenteditable=\"true\" data-source=\"" + source + "\" data-field=\"" + field + "\" title=\"Click để sửa — click ra ngoài để lưu\"";
        if (id.HasValue) attrs += " data-id=\"" + id.Value + "\"";
        return attrs;
    };
    var editClass = isAdmin ? "js-inline-edit" : null;
}

<!-- BEGIN: HeroSection (Dynamic from Banners GroupId = 1 & ConfigSite) -->
<section class="hero-section">
    <div class="container">
        <div class="row align-items-center g-5">
            <!-- Left Hero Content -->
            <div class="col-lg-6">
                <!-- Trust Badge -->
                <div class="hero-badge">
                    <i class="fa-solid fa-shield-halved text-primary"></i>
                    <span class="@(isAdmin && heroBanner != null ? "js-inline-edit" : null)"@Html.Raw(EditAttrs("Content", "banner", heroBanner?.Id))>@heroBadge</span>
                </div>

                <!-- Headline -->
                <h1 class="hero-title @(isAdmin && heroBanner != null ? "js-inline-edit" : null)"@Html.Raw(EditAttrs("BannerName", "banner", heroBanner?.Id))>
                    @Html.Raw(heroTitle)
                </h1>

                <!-- Description -->
                <p class="hero-desc @(isAdmin && heroBanner != null ? "js-inline-edit" : null)"@Html.Raw(EditAttrs("Slogan", "banner", heroBanner?.Id))>
                    @heroDesc
                </p>

                <!-- Action CTAs -->
                <div class="d-flex flex-wrap align-items-center gap-3 mb-4">
                    <button type="button" onclick="window.selectCarAndBook()" class="btn btn-brand-orange px-4 py-3 fw-bold fs-6">
                        <i class="fa-regular fa-file-lines me-2"></i>
                        <span>Nhận báo giá ngay</span>
                    </button>
                    <a class="btn btn-brand-outline px-4 py-3 fw-bold fs-6 d-inline-flex align-items-center gap-2" href="@zaloUrl" target="_blank" rel="noopener">
                        <i class="fa-solid fa-phone-volume text-primary"></i>
                        <span>Gọi / Zalo ngay</span>
                    </a>
                </div>

                <!-- Feature Bullets -->
                <div class="hero-features">
                    <div class="item">
                        <i class="fa-solid fa-car text-primary"></i>
                        <span>Xe đời mới 100%</span>
                    </div>
                    <div class="item">
                        <i class="fa-solid fa-user-tie text-primary"></i>
                        <span>Tài xế chuẩn mực</span>
                    </div>
                    <div class="item">
                        <i class="fa-solid fa-shield-check text-primary"></i>
                        <span>Giá trọn gói minh bạch</span>
                    </div>
                </div>
            </div>

            <!-- Right Hero Image -->
            <div class="col-lg-6">
                <div class="hero-img-wrap">
                    <img src="@heroImg" alt="@siteTitle" />
                    <div class="hero-img-overlay-badge">
                        @siteTitle
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- END: HeroSection -->

<!-- BEGIN: BookingCardForm Section -->
<section class="container booking-section-wrap" id="booking-form">
    @Html.Action("Form", "Home")
</section>
<!-- END: BookingCardForm Section -->

<!-- BEGIN: VehicleFleet Slider (Dynamic from CarServices table) -->
<section class="fleet-section-wrap" id="tuyen-xe">
    <div class="container">
        <div class="text-center mb-4">
            <h2 class="section-title mb-2 @editClass"@Html.Raw(EditAttrs("HomeFleetTitle", "config", null))>@fleetTitle</h2>
            <div class="title-line text-primary mb-2">
                <i class="fa-solid fa-car-side fs-5"></i>
            </div>
            <p class="section-subtitle @editClass"@Html.Raw(EditAttrs("HomeFleetDesc", "config", null))>@fleetDesc</p>
        </div>

        <!-- Fleet Slider Container -->
        <div class="fleet-slider-container">
            <!-- Custom Prev/Next Navigation Buttons (Slender Minimalist Arrows) -->
            <button type="button" class="fleet-nav-btn fleet-nav-prev" id="fleetPrevBtn" aria-label="Xe trước">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
            </button>
            <button type="button" class="fleet-nav-btn fleet-nav-next" id="fleetNextBtn" aria-label="Xe kế tiếp">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
            </button>

            <!-- Slick Slider Track -->
            <div class="fleet-slider" id="fleetSlickSlider">
                @if (services.Any())
                {
                    foreach (var car in services)
                    {
                        var capacity = !string.IsNullOrWhiteSpace(car.Capacity) ? car.Capacity : (car.Title ?? "Xe du lịch");
                        var img = !string.IsNullOrWhiteSpace(car.Image)
                            ? (car.Image.StartsWith("http") ? car.Image : Url.Content("~/images/services/" + car.Image))
                            : "https://lh3.googleusercontent.com/aida-public/AB6AXuBxH9mM3TTqypemJmIspSjhh78iSk2e6dFPMa1Baap857mWAR3BixkGaeQR7BLOZIzmUj6HNeVGraRNBpwZADIY3TOcrn6XVDQmpZFG3pPbLB1hT8pYHhP4WHSJNzu91LrOx5nHAMd7x9tfqNfp47_A1r5UuZdEMw2USWeoL29vZPEaqgreInmmpsFtGc1bXAquR1WSd9ZR0S_IhZG5o_nopXLNvq4AnnOoujRrCfcreM7EPnGLNdCYAw";
                        var carUrl = Url.Action("ServiceCar", "Home", new { url = car.Slug });
                        
                        <div>
                            <div class="fleet-card-luxury">
                                <!-- Full-bleed Car Stage -->
                                <div class="fleet-stage">
                                    <img src="@img" alt="@car.Title" />
                                    <!-- Floating Badges Overlay (Dynamic from Capacity & Slogan) -->
                                    <div class="fleet-card-header">
                                        <span class="fleet-pill-badge">@capacity</span>
                                        @if (!string.IsNullOrWhiteSpace(car.Slogan))
                                        {
                                            <span class="fleet-tag-pill">
                                                <i class="fa-solid fa-sparkles"></i> @car.Slogan
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="fleet-tag-pill">
                                                <i class="fa-solid fa-sparkles"></i> Đời mới 2024
                                            </span>
                                        }
                                    </div>
                                </div>

                                <!-- Card Content -->
                                <div class="fleet-card-body">
                                    <div>
                                        <h3 class="fleet-car-title">@car.Title</h3>
                                        <div class="fleet-car-models" title="@(car.Car ?? car.Title)">
                                            <i class="fa-solid fa-car-side text-primary me-1"></i>
                                            <span>@(car.Car ?? car.Title)</span>
                                        </div>

                                        <!-- Specifications Box (100% Dynamic from CarServices fields) -->
                                        <div class="fleet-spec-list">
                                            <div class="spec-item">
                                                <i class="fa-solid fa-couch text-primary"></i>
                                                <span><strong>Ghế ngồi:</strong> @(!string.IsNullOrWhiteSpace(car.Capacity) ? car.Capacity : (car.Car ?? car.Title)) êm ái</span>
                                            </div>
                                            <div class="spec-item">
                                                <i class="fa-solid fa-snowflake text-info"></i>
                                                <span><strong>Tiện nghi:</strong> @(!string.IsNullOrWhiteSpace(car.Speed) ? car.Speed : "Điều hòa 2 vùng mát lạnh")</span>
                                            </div>
                                            <div class="spec-item">
                                                <i class="fa-regular fa-calendar-check text-success"></i>
                                                <span><strong>Mục đích:</strong> @(!string.IsNullOrWhiteSpace(car.Type) ? car.Type : "Đoàn thể, sự kiện, du lịch")</span>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Action Buttons (Refined Dual Pills) -->
                                    <div class="fleet-card-actions">
                                        <button type="button" onclick="window.selectCarAndBook('@capacity')" class="btn-fleet-book">
                                            <span>Đặt xe</span>
                                        </button>
                                        <a href="@carUrl" class="btn-fleet-detail">
                                            <span>Chi tiết</span>
                                            <i class="fa-solid fa-arrow-right small"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</section>
<!-- END: VehicleFleet Slider -->

<!-- BEGIN: PricingTableSection (Dynamic from PriceLangdings & Locations table) -->
<section class="py-5 bg-white border-top" id="bang-gia">
    <div class="container">
        <!-- Trust Badges Header -->
        <div class="d-flex flex-wrap justify-content-center align-items-center gap-3 mb-3">
            <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 rounded-pill fw-semibold">
                <i class="fa-solid fa-shield-check me-1"></i> Giá minh bạch
            </span>
            <span class="badge bg-success bg-opacity-10 text-success px-3 py-2 rounded-pill fw-semibold">
                <i class="fa-solid fa-comments me-1"></i> Tư vấn nhanh
            </span>
            <span class="badge bg-warning bg-opacity-10 text-dark px-3 py-2 rounded-pill fw-semibold">
                <i class="fa-solid fa-headset me-1"></i> Hỗ trợ 24/7
            </span>
        </div>

        <!-- Section Title -->
        <div class="text-center mb-4">
            <h2 class="section-title text-uppercase mb-2 @editClass"@Html.Raw(EditAttrs("HomePriceTitle", "config", null))>@priceTitle</h2>
            <div class="title-line text-primary mb-2"></div>
            <p class="section-subtitle @editClass"@Html.Raw(EditAttrs("HomePriceDesc", "config", null))>@priceDesc</p>
        </div>

        <!-- Pricing Matrix Table -->
        <div class="pricing-matrix-wrap">
            <table class="table pricing-table align-middle">
                <thead>
                    <tr>
                        <th class="route-th" style="min-width: 200px;">
                            <div class="d-flex align-items-center gap-2">
                                <i class="fa-solid fa-location-dot fs-5 text-info"></i>
                                <div>
                                    <div class="fw-bold">HÀNH TRÌNH</div>
                                    <div class="small fw-normal text-white-50">2 CHIỀU</div>
                                </div>
                            </div>
                        </th>
                        <th style="min-width: 110px;">
                            <i class="fa-solid fa-car text-primary d-block mb-1"></i>
                            <span>4 CHỖ</span>
                        </th>
                        <th style="min-width: 110px;">
                            <i class="fa-solid fa-van-shuttle text-primary d-block mb-1"></i>
                            <span>7 CHỖ</span>
                        </th>
                        <th style="min-width: 110px;">
                            <i class="fa-solid fa-bus-simple text-primary d-block mb-1"></i>
                            <span>16 CHỖ</span>
                        </th>
                        <th style="min-width: 110px;">
                            <i class="fa-solid fa-bus text-primary d-block mb-1"></i>
                            <span>29 CHỖ</span>
                        </th>
                        <th style="min-width: 110px;">
                            <i class="fa-solid fa-bus text-primary d-block mb-1"></i>
                            <span>45 CHỖ</span>
                        </th>
                        <th style="min-width: 110px;">
                            <i class="fa-solid fa-star text-warning d-block mb-1"></i>
                            <span>LIMOUSINE</span>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var allLocations = priceLangdings
                            .SelectMany(p => p.Locations ?? new List<Location>())
                            .Where(l => l.Active)
                            .OrderBy(l => l.Sort)
                            .ToList();

                        var displayRoutes = allLocations.GroupBy(l => l.Name).Select(g => g.First()).Take(10).ToList();
                    }

                    @if (displayRoutes.Any())
                    {
                        foreach (var loc in displayRoutes)
                        {
                            var isHot = loc.Hot;
                            var p4 = !string.IsNullOrWhiteSpace(loc.Price4) ? loc.Price4 : "Liên hệ";
                            var p7 = !string.IsNullOrWhiteSpace(loc.Price7) ? loc.Price7 : "Liên hệ";
                            var p16 = !string.IsNullOrWhiteSpace(loc.Price16) ? loc.Price16 : "Liên hệ";
                            var p29 = !string.IsNullOrWhiteSpace(loc.Price29) ? loc.Price29 : "Liên hệ";
                            var p45 = !string.IsNullOrWhiteSpace(loc.Price45) ? loc.Price45 : "Liên hệ";
                            var pLim = !string.IsNullOrWhiteSpace(loc.PriceLim) ? loc.PriceLim : "Liên hệ";

                            <tr class="@(isHot ? "is-hot-row" : "")" onclick="window.selectRouteAndBook('Hà Nội', '@loc.Name', '7 chỗ')">
                                <td class="route-td">
                                    <div class="d-flex align-items-center">
                                        @if (isHot)
                                        {
                                            <span class="price-hot-tag"><i class="fa-solid fa-fire"></i> HOT</span>
                                        }
                                        else
                                        {
                                            <i class="fa-solid fa-location-dot text-primary me-2 small"></i>
                                        }
                                        <span>Hà Nội ↔ @loc.Name</span>
                                    </div>
                                </td>
                                <td><span class="price-val @(isHot ? "hot-price" : "") @(p4 == "Liên hệ" ? "contact-price" : "")">@p4</span></td>
                                <td><span class="price-val @(isHot ? "hot-price" : "") @(p7 == "Liên hệ" ? "contact-price" : "")">@p7</span></td>
                                <td><span class="price-val @(isHot ? "hot-price" : "") @(p16 == "Liên hệ" ? "contact-price" : "")">@p16</span></td>
                                <td><span class="price-val @(p29 == "Liên hệ" ? "contact-price" : "")">@p29</span></td>
                                <td><span class="price-val @(p45 == "Liên hệ" ? "contact-price" : "")">@p45</span></td>
                                <td><span class="price-val @(pLim == "Liên hệ" ? "contact-price" : "")">@pLim</span></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- Notes and Fast Prompt Card -->
        <div class="row g-4 align-items-stretch">
            <!-- Left: Notes (ConfigSite or Standard) -->
            <div class="col-md-6">
                <div class="bg-light p-4 rounded-3 border h-100 d-flex gap-3 align-items-start">
                    <div class="p-3 bg-primary bg-opacity-10 rounded-circle text-primary flex-shrink-0">
                        <i class="fa-solid fa-clipboard-check fs-4"></i>
                    </div>
                    <div class="small text-secondary">  
                        <h4 class="h6 fw-bold text-dark text-uppercase mb-2 @editClass"@Html.Raw(EditAttrs("HomePriceNoteTitle", "config", null))>@priceNoteTitle</h4>
                        @if (!string.IsNullOrWhiteSpace(config?.Price))
                        {
                            @Html.Raw(config.Price)
                        }
                        else
                        {
                            <p class="mb-1"><i class="fa-solid fa-check text-success me-1"></i> Giá trên đã bao gồm xăng dầu, lương lái xe</p>
                            <p class="mb-1"><i class="fa-solid fa-check text-success me-1"></i> Giá chưa gồm phí cầu đường cao tốc và VAT 8% (nếu có)</p>
                            <p class="mb-1"><i class="fa-solid fa-check text-success me-1"></i> Giá thay đổi linh hoạt theo thời điểm hoặc hành trình thực tế</p>
                            <p class="mb-0"><i class="fa-solid fa-check text-success me-1"></i> Giá chưa bao gồm phí lưu đêm của xe (nếu đi nhiều ngày)</p>
                        }
                    </div>
                </div>
            </div>

            <!-- Right: Prompt Fast Booking -->
            <div class="col-md-6">
                <div class="p-4 rounded-3 border h-100 d-flex flex-column justify-content-between" style="background-color: var(--brand-sky); border-color: var(--brand-sky-border) !important;">
                    <button type="button" onclick="window.selectCarAndBook()" class="btn btn-primary p-3 rounded-3 d-flex align-items-center justify-content-between text-start mb-3 shadow-sm" style="background-color: var(--brand-dark-blue); border: none;">
                        <div class="d-flex align-items-center gap-3">
                            <div class="p-2 bg-white bg-opacity-10 rounded-circle text-white">
                                <i class="fa-solid fa-phone-volume fs-5"></i>
                            </div>
                            <div>
                                <div class="fw-bold fs-6 @editClass"@Html.Raw(EditAttrs("HomeCtaTitle", "config", null))>@ctaTitle</div>
                                <div class="small text-white-50 @editClass"@Html.Raw(EditAttrs("HomeCtaDesc", "config", null))>@ctaDesc</div>
                            </div>
                        </div>
                        <i class="fa-solid fa-arrow-right fs-5 text-white"></i>
                    </button>

                    <!-- 3 Service Commitments -->
                    <div class="row text-center pt-2 border-top border-primary border-opacity-10">
                        <div class="col-4">
                            <i class="fa-solid fa-shield-check text-primary fs-5 mb-1 d-block"></i>
                            <div class="fw-bold small text-dark">An toàn</div>
                            <div class="text-muted" style="font-size: 0.75rem;">Tài xế chuẩn mực</div>
                        </div>
                        <div class="col-4">
                            <i class="fa-regular fa-clock text-primary fs-5 mb-1 d-block"></i>
                            <div class="fw-bold small text-dark">Đúng giờ</div>
                            <div class="text-muted" style="font-size: 0.75rem;">Cam kết đón đúng hẹn</div>
                        </div>
                        <div class="col-4">
                            <i class="fa-solid fa-hand-holding-heart text-danger fs-5 mb-1 d-block"></i>
                            <div class="fw-bold small text-dark">Tận tâm</div>
                            <div class="text-muted" style="font-size: 0.75rem;">Phục vụ chu đáo</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- END: PricingTableSection -->

<!-- BEGIN: TestimonialsSection (Dynamic from Banners GroupId = 2) -->
@if (reviews.Any())
{
    <section class="py-5 bg-light" id="gioi-thieu">
        <div class="container">
