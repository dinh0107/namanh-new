@section scripts{
    <script>
        homeJs();

        function loadArticlesById(id) {
            $.ajax({
                url: '@Url.Action("GetArticle", "Home")',
                type: 'GET',
                data: { id: id },
                success: function (result) {
                    $('#body-ar').html(result);
                },
                error: function () {
                }
            });
        }

        $(document).ready(function () {
            var firstBtn = $('.filter-btn').first();
            if (!firstBtn.length) return;
            var firstId = firstBtn.data('id');
            loadArticlesById(firstId);
            firstBtn.addClass('active');
        });

        $(document).on('click', '.filter-btn', function() {
            var id = $(this).data('id');
            $('.filter-btn').removeClass('active');
            $(this).addClass('active');
            loadArticlesById(id);
        });
    </script>
    <script type="application/ld+json">
        {
          "@Html.Raw("@context")": "https://schema.org",
          "@Html.Raw("@type")": "WebPage",
          "name": "@Html.Raw(ViewBag.Title)",
          "description": "@Html.Raw(ViewBag.Description)",
          "url": "@ViewBag.Canonical",
          "mainEntityOfPage": "@ViewBag.Canonical"
        }
    </script>
}