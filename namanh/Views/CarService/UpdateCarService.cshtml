@model namanh.Models.CarService
@{
    ViewBag.Title = "Cập nhật Dòng xe cho thuê";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<div class="page-header">
    <div class="page-title">
        <i class="fa-solid fa-car-side fa-sm"></i>
        <span>Cập nhật Dòng xe cho thuê</span>
    </div>
    <a href="#" onclick="history.go(-1)" class="btn-main btn-labeled bg-brown">
        <span class="icon">
            <i class="fa-solid fa-left"></i>
        </span>
        Quay lại
    </a>
</div>
<div class="content">
    @if (ViewBag.ArticleCat == "success")
    {
        <div id="AlertBox" class="alert alert-success"><strong>Thêm thành công</strong></div>
    }
    @if (ViewBag.ArticleCat == "update")
    {
        <div id="AlertBox" class="alert alert-success"><strong>Cập nhật thành công</strong></div>
    }
    <div class="accordion">
        <div class="accordion-item border-left-slate">
            <div class="accordion-header">
                <div class="card-title">
                    <i class="fa-light fa-octagon-plus fa-lg"></i>
                    Sửa
                </div>
                <button type="button" data-bs-toggle="collapse" data-bs-target="#createForm" aria-expanded="true">
                    <i class="fa-solid fa-angle-down"></i>
                </button>
            </div>
            <div id="createForm" class="accordion-collapse collapse show">
                <div class="accordion-body">
                    @using (Html.BeginForm("UpdateCarService", "CarService", FormMethod.Post, new { @id = "data-insert-form", enctype = "multipart/form-data" }))
                    {
                        @Html.ValidationSummary(true)
                        @Html.HiddenFor(a => a.Id)
                        <div class="mb-3 row">
                            <label class="col-form-label col-lg-3" for="Title">Tên dòng xe (Tiêu đề thẻ)<span class="text-danger">*</span></label>
                            <div class="col-lg-9">
                                @Html.TextBoxFor(a => a.Title, new { @class = "form_control w300", placeholder = "VD: Thuê xe 29 chỗ" })
                            </div>
                        </div>
                        <div class="mb-3 row">
                            <label class="col-form-label col-lg-3" for="Slogan">Tag nhãn nổi bật (Badge góc phải)</label>
                            <div class="col-lg-9">
                                @Html.TextBoxFor(a => a.Slogan, new { @class = "form_control w300", placeholder = "VD: Đời mới 2024 hoặc VIP Luxury" })
                            </div>
                        </div>
                        <div class="mb-3 row">
                            <label class="col-form-label col-lg-3" for="Car">Danh sách mẫu xe</label>
                            <div class="col-lg-9">
                                @Html.TextBoxFor(a => a.Car, new { @class = "form_control w300", placeholder = "VD: Hyundai County, Thaco Town" })
                            </div>
                        </div>
                        <div class="mb-3 row">
                            @Html.LabelFor(a => a.Description, new { @class = "col-form-label col-lg-3" })
                            <div class="col-lg-9">
                                @Html.EditorFor(a => a.Description)
                                @Html.ValidationMessageFor(a => Model.Description)
                            </div>
                        </div>
                        <div class="mb-3 row">
                            @Html.LabelFor(a => a.Image, new { @class = "col-form-label col-lg-3" })
                            <div class="col-lg-9">
                                @Html.TextBoxFor(a => a.Image, new { type = "file" })
                                <div class="text-danger mt-2">Chấp nhận ảnh jpg, png, gif, jpeg < 4MB</div>
                            </div>
                        </div>
                        if (Model.Image != null)
                        {
                            <div class="mb-3 row" id="ImgPreview">
                                <label class="col-form-label col-lg-3"></label>
                                <div class="col-lg-9">
                                    <img class="img-border mb-2" src="@Path.Combine("/images/carService/", Model.Image)" />
                                    <a href="javascript:;" onclick="$('#CurrentFileImg').hide(); $('#CurrentFileImg').val('');" class="delete-img">
                                        <img src="~/Content/images/admin/icon-delete-red.png" alt="" style="vertical-align: middle; margin-top: 0; height: 10px;" /> Xóa ảnh
                                    </a>
                                    <input type="hidden" name="CurrentFileImg" id="CurrentFileImg" value="@Model.Image" />
                                </div>
                            </div>
                        }
                        <div class="mb-3 row">
                            @Html.LabelFor(a => a.ImageUrl, new { @class = "col-form-label col-lg-3" })
                            <div class="col-lg-9">
                                @Html.TextBoxFor(a => a.ImageUrl, new { type = "file" })
                                <div class="text-danger mt-2">Chấp nhận ảnh jpg, png, gif, jpeg < 4MB</div>
                            </div>
                        </div>
                        if (Model.ImageUrl != null)
                        {
                            <div class="mb-3 row" id="ImgPreview">
                                <label class="col-form-label col-lg-3"></label>
                                <div class="col-lg-9">
                                    <img class="img-border mb-2" src="@Path.Combine("/images/carService/", Model.ImageUrl)" />
                                    <a href="javascript:;" onclick="$('#ImgPreview').hide(); $('#CurrentFile').val('');" class="delete-img">
                                        <img src="~/Content/images/admin/icon-delete-red.png" alt="" style="vertical-align: middle; margin-top: 0; height: 10px;" /> Xóa ảnh
                                    </a>
                                    <input type="hidden" name="CurrentFile" id="CurrentFile" value="@Model.ImageUrl" />
                                </div>
                            </div>
                        }
                        <div class="mb-3 row">
                            @Html.LabelFor(a => a.ImageUrlMobile, new { @class = "col-form-label col-lg-3" })
                            <div class="col-lg-9">
                                @Html.TextBoxFor(a => a.ImageUrlMobile, new { type = "file" })
                                <div class="text-danger mt-2">Chấp nhận ảnh jpg, png, gif, jpeg < 4MB</div>
                            </div>
                        </div>
                        if (Model.ImageUrlMobile != null)
                        {
                            <div class="mb-3 row" id="ImgPreview">
                                <label class="col-form-label col-lg-3"></label>
                                <div class="col-lg-9">
                                    <img class="img-border mb-2" src="@Path.Combine("/images/carService/", Model.ImageUrlMobile)" />
                                    <a href="javascript:;" onclick="$('#ImgPreview').hide(); $('#CurrentFileMobile').val('');" class="delete-img">
                                        <img src="~/Content/images/admin/icon-delete-red.png" alt="" style="vertical-align: middle; margin-top: 0; height: 10px;" /> Xóa ảnh
                                    </a>
                                    <input type="hidden" name="CurrentFileMobile" id="CurrentFileMobile" value="@Model.ImageUrlMobile" />
                                </div>
                            </div>
                        }
                        <div id="ListImage" class="mb-3 row">
                            <div class="col-form-label col-lg-3">@Html.LabelFor(model => model.ListImage)</div>
                            <div class="col-lg-9">
                                <div class="alert alert-info">
                                    <p class="btn btn-success fileinput-button">
                                        <i class="glyphicon glyphicon-plus"></i>
                                        <span>Chọn ảnh...</span>
                                        <input type="file" id="fileupload" name="files[]" accept="image/*" multiple="" />
                                    </p><br />
                                    - Chọn ảnh để upload: (gif, png, jpg, jpeg < 4MB)<br />
                                    - Kích thước: 800x 800px<br />
                                    - Ảnh đầu tiên sẽ là ảnh đại diện<br />
                                </div>
                                <div id="progress" class="progress">
                                    <div class="progress-bar progress-bar-success"></div>
                                </div>
                            </div>
                        </div>
                        <div class="mb-3 row">
                            <div class="col-form-label col-lg-3"></div>
                            <div class="col-lg-9">
                                <ul id="ListImages">
                                    @if (Model.ListImage != null)
                                    {
                                        var i = 1;
                                        var arrPic = Model.ListImage.Split(',');
                                        foreach (var item in arrPic)
                                        {
                                            <li class="thumb-img-box">
                                                <input type="hidden" name="Pictures" value="@item" />
                                                <img src="@Path.Combine("/images/service/",item)?w=80&h=80&mode=crop" alt="" />
                                                <a href="javascript:;" id="@i" onclick="delfile( '@i')"><img src="~/Content/images/admin/icon-delete.png" alt="" /></a>
                                            </li>
                                            i = i + 1;
                                        }
                                    }
                                </ul>
                            </div>
                        </div>
                        <div class="mb-3 row">
                            <div class="col-lg-3">
                                <label>Thông số hiển thị thẻ xe</label>
                            </div>
                            <div class="col-lg-9 row">
                                <div class="col-6">
                                    <div class="row mb-3">
                                        <label class="col-form-label col-lg-4" for="Capacity">Số ghế ngồi (Badge)</label>
                                        <div class="col-lg-8">
                                            @Html.TextBoxFor(a => a.Capacity, new { @class = "form_control w300", placeholder = "VD: 29 chỗ ngồi" })
                                        </div>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="row mb-3">
                                        <label class="col-form-label col-lg-4" for="Speed">Tiện nghi trang bị</label>
                                        <div class="col-lg-8">
                                            @Html.TextBoxFor(a => a.Speed, new { @class = "form_control w300", placeholder = "VD: Điều hòa 2 vùng mát lạnh" })
                                        </div>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="row mb-3">
                                        <label class="col-form-label col-lg-4" for="Type">Mục đích phục vụ</label>
                                        <div class="col-lg-8">
                                            @Html.TextBoxFor(a => a.Type, new { @class = "form_control w300", placeholder = "VD: Đoàn thể, sự kiện, du lịch" })
                                        </div>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="row mb-3">
                                        <label class="col-form-label col-lg-4" for="Firm">Hãng xe</label>
                                        <div class="col-lg-8">
                                            @Html.TextBoxFor(a => a.Firm, new { @class = "form_control w300", placeholder = "VD: Hyundai / Toyota" })
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="mb-3 row">
                            @Html.LabelFor(a => a.Body, new { @class = "col-form-label col-lg-3" })
                            <div class="col-lg-9">
                                @Html.EditorFor(a => a.Body)
                                @Html.ValidationMessageFor(a => Model.Body)
                            </div>
                        </div>
                        <div class="mb-3 row">
                            @Html.LabelFor(a => a.Sort, new { @class = "col-form-label col-lg-3" })
                            <div class="col-lg-9">
                                @Html.EditorFor(a => a.Sort)
                                @Html.ValidationMessageFor(a => Model.Sort)
                            </div>
                        </div>
                        <div class="mb-3 row">
                            @Html.LabelFor(a => a.Home, new { @class = "col-form-label col-lg-3" })
                            <div class="col-lg-9">
                                <label class="form-check-label">
                                    <input type="checkbox" name="Home" @if (Model.Home) { @Html.Raw("value='true' checked")  } else { @Html.Raw("value='false'") } />
                                    <span class="checkmark"></span>
                                </label>
                            </div>
                        </div>
                        <div class="mb-3 row">
                            @Html.LabelFor(a => a.Menu, new { @class = "col-form-label col-lg-3" })
                            <div class="col-lg-9">
                                <label class="form-check-label">
                                    <input type="checkbox" name="Menu" @if (Model.Menu) { @Html.Raw("value='true' checked")  } else { @Html.Raw("value='false'") } />
                                    <span class="checkmark"></span>
                                </label>
                            </div>
                        </div>
                        <div class="mb-3 row">
                            @Html.LabelFor(a => a.Active, new { @class = "col-form-label col-lg-3" })
                            <div class="col-lg-9">
                                <label class="form-check-label">
                                    <input type="checkbox" name="Active" @if (Model.Active) { @Html.Raw("value='true' checked")  } else { @Html.Raw("value='false'") } />
                                    <span class="checkmark"></span>
                                </label>
                            </div>
                        </div>
                        
                        <div class="mb-3 row">
                            @Html.LabelFor(a => a.TitleMeta, new { @class = "col-form-label col-lg-3" })
                            <div class="col-lg-9">
                                @Html.EditorFor(a => a.TitleMeta)
                            </div>
                        </div>
                        <div class="mb-3 row">
                            @Html.LabelFor(a => a.DescriptionMeta, new { @class = "col-form-label col-lg-3" })
                            <div class="col-lg-9">
                                @Html.EditorFor(a => a.DescriptionMeta)
                            </div>
                        </div>
                        <div class="btn-group">
                            <button type="reset" onclick="resetAnyFormById('data-insert-form');" class="btn-main btn-white" id="reset">
                                <span>Đặt lại</span>
                                <i class="fa-solid fa-rotate-right ms-2"></i>
                            </button>
                            <button type="submit" class="btn-main btn-primary text-white ms-3">
                                <span>Lưu</span>
                                <i class="fa-solid fa-floppy-disk ms-2"></i>
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
        @Html.Action("ListCarService", "CarService")
    </div>
</div>
@section scripts{
    <script>
        $(function () {
            $("#ListImages").sortable();
            $("#ListImages").disableSelection();
        });
        var i = 1;
        $("#fileupload").fileupload({
            add: function (e, data) {
                var uploadErrors = [];
                var acceptFileTypes = /^image\/(gif|jpe?g|png)$/i;
                if (data.originalFiles[0]["type"].length && !acceptFileTypes.test(data.originalFiles[0]["type"])) {
                    uploadErrors.push("Chỉ chấp nhận định dạng jpeg, jpg, png, gif");
                }
                if (data.originalFiles[0]["size"] > 4000000) {
                    uploadErrors.push("Dung lượng ảnh lớn hơn 4MB");
                }
                var totalImg = $("#ListImages .thumb-img-box").length;
                if (totalImg >= 30) {
                    uploadErrors.push("Chỉ đăng tối đa 20 ảnh");
                }
                if (uploadErrors.length > 0) {
                    alert(uploadErrors.join("\n"));
                    return false;
                } else {
                    data.submit();
                }
                return true;
            },
            url: "/Uploader/Upload?folder=service&r=" + Math.random(),
            dataType: "json",
            done: function (e, data) {
                $.each(data.result.files, function (index, file) {
                    $('#ListImages').append('<li class="thumb-img-box"><input type="hidden" name="Pictures" value ="' + file.name + '" /><img src="/images/service/' + file.name + '?w=80&h=80"/><a href="javascript:;" id="' + i + '" onclick="delfile(' + i + ')"><img src="/Content/images/admin/icon-delete.png" alt="" style="vertical-align:middle" /></a></li>');
                });
                i = i + 1;
                $("#progress").fadeOut(2000);
            },
            start: function () {
                $("#progress .progress-bar").css("width", "0");
                $("#progress").show();
            },
            progressall: function (e, data) {
                var progress = parseInt(data.loaded / data.total * 100, 10);
                $("#progress .progress-bar").css("width", progress + "%");
            }
        }).prop('disabled', !$.support.fileInput).parent().addClass($.support.fileInput ? undefined : 'disabled');

        function delfile(divid) {
            if (confirm('Bạn có chắc xóa ảnh này?')) {
                $('#' + divid).parent().fadeOut().remove();
            }
        }
    </script>
}